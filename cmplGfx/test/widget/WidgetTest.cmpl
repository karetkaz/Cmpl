// Color picker demo.

struct ColorPicker: View {
	float32 hue = 0.591667;
	float32 lum = 0.523438;

	static argb get(ColorPicker this, float32 x, float32 y) {
		// todo: use integer based color space conversions
		return argb(hsl2rgb(vec4f(x, 1, y)));
	}

	static argb value(ColorPicker this) {
		return this.get(this.hue, 1 - this.lum);
	}

	bool onUpdate(ColorPicker this, argb value) {
		return true;
	}

	State onTouchEvent^(ColorPicker this, Rect rect!, TouchEvent event!) {
		if (event.release || !event.button) {
			return View.onTouchEvent(this, rect, event);
		}

		this.hue = Float32.clamp(float32(event.x - rect.x0), 0f, rect.width() - 1f) / rect.width();
		this.lum = Float32.clamp(float32(event.y - rect.y0), 0f, rect.height() - 1f) / rect.height();
		if (this.onUpdate(this, this.value())) {
			return State.handled;
		}
		return State.ignored;
	}

	bool onMeasure^(Histogram this, Rect rect&) {
		if (this.height == 0) {
			rect.height(128);
		} else {
			rect.height(this.height);
		}
		return View.onMeasure(this, &rect);
	}

	void onDraw^(ColorPicker this, Image offs, Rect rect) {
		int32 width = rect.width();
		int32 height = rect.height();
		for (int32 y = rect.y0; y < rect.y1; y += 1) {
			float32 py = 1 - float32(y - rect.y0) / height;
			for (int32 x = rect.x0; x < rect.x1; x += 1) {
				float32 px = float32(x - rect.x0) / width;
				offs.set(x, y, this.get(px, py));
			}
		}

		int32 x = rect.x0 + Float32.clamp(float32(this.hue * width), 0f, width - 1f);
		int32 y = rect.y0 + Float32.clamp(float32(this.lum * height), 0f, height - 1f);
		offs.drawOval(x - 4, y - 4, x + 4, y + 4, 0x000000);
		offs.drawOval(x - 2, y - 2, x + 2, y + 2, 0xffffff);
		offs.drawOval(x - 1, y - 1, x + 1, y + 1, 0x000000);
	}
}

static void onPrintStyle(Button button, int32 clicks) {
	Style style! = button.style;
	debug("style", style);
}
static bool updateColor(ColorPicker this, argb value);
static bool updateSlider(Slider this, float64 value);
static bool updateTheme(Switch this, int32 value);

static ColorPicker colorPicker = {
	width: 360,
	height: 256/2,
	focusable: false,
	onUpdate: updateColor,
};

char themes[][] = {
	"Light",
	"Dark"
};
static Switch theme = {
	text: "Dark theme",
	states: null,
	selected: 1,
	onUpdate: updateTheme,
};
static Slider slider = {
	text: "Color saturation",
	value: 0.75,
	onUpdate: updateSlider,
};

Slider stepSlider = {
	text: "stepped slider",
	value: 0.72767676,
	stepSize: 1. / 10,
};

static char switchStates[][] = {
	"Option 1", "Option 2", "Option 3", "Option 4", "Option 5",
};
Switch switch = {
	text: "Multi switch",
	states: switchStates,
};

Button printStyle = {
	text: "Dump style",
	onClick: onPrintStyle,
};

char nameBuffer[100] = {0};
Input input = {
	text: nameBuffer,
	placeholder: "text input",
};

DebugView debug = {
	focusable: false,
};

static Style style = Widget.defaultStyle;
Window.show(Widget(0, 0, style).addItems(
	colorPicker,

	null,
	theme,
	slider,

	switch,
	printStyle,

	null, stepSlider,
	null, input,

	null, debug
));

static void updateTheme() {
	argb value = argb(hsl2rgb(vec4f(colorPicker.hue, slider.value, 1 - colorPicker.lum)));
	if (theme.selected != 0) {
		style.setColor(Style.dark, value);
	} else {
		style.setColor(Style.light, value);
	}
}
static bool updateColor(ColorPicker this, argb value) {
	if (!ColorPicker.onUpdate(this, value)) {
		return false;
	}
	updateTheme();
	return true;
}
static bool updateTheme(Switch this, int32 value) {
	if (!Switch.onUpdate(this, value)) {
		return false;
	}
	if (theme.selected != 0) {
		if (colorPicker.lum > .75) {
			colorPicker.lum = 1 - colorPicker.lum;
		}
	} else {
		if (colorPicker.lum < .25) {
			colorPicker.lum = 1 - colorPicker.lum;
		}
	}
	updateTheme();
	return true;
}

static bool updateSlider(Slider this, float64 value) {
	if (!Slider.onUpdate(this, value)) {
		return false;
	}
	updateTheme();
	return true;
}
