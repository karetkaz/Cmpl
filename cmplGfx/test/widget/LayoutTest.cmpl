// test layout direction, alignment, and padding. todo: spacing
// based on: https://developer.microsoft.com/en-us/fluentui#/controls/web/stack

bool syncOrientation(Slider this, float64 value);
static bool syncAlignment(Switch this, int value);
static bool syncPadding(Slider this, float64 value);

inline itemSize = -50;
inline minPadding = 0;
inline maxPadding = 1000;

Slider orientation = {
	onUpdate: syncOrientation;
	text: "orientation";
	minimum: -4;
	maximum: 10;
	value: -1;
	stepSize: 1;
};

static Slider paddingTop = {
	onUpdate: syncPadding;
	text: "LayoutPadding.top";
	minimum: minPadding;
	maximum: maxPadding;
	value: 20;
	stepSize: 1;
};
static Slider paddingLeft = {
	onUpdate: syncPadding;
	text: "LayoutPadding.left";
	minimum: minPadding;
	maximum: maxPadding;
	value: 20;
	stepSize: 1;
};
static Slider paddingRight = {
	onUpdate: syncPadding;
	text: "LayoutPadding.right";
	minimum: minPadding;
	maximum: maxPadding;
	value: 256;
	stepSize: 1;
};
static Slider paddingBottom = {
	onUpdate: syncPadding;
	text: "LayoutPadding.bottom";
	minimum: minPadding;
	maximum: maxPadding;
	value: 20;
	stepSize: 1;
};

static Switch layoutAlignTop = {
	onUpdate: syncAlignment;
	text: "LayoutAlign.top";
	states: null;
};
static Switch layoutAlignLeft = {
	onUpdate: syncAlignment;
	text: "LayoutAlign.left";
	states: null;
};
static Switch layoutAlignRight = {
	onUpdate: syncAlignment;
	text: "LayoutAlign.right";
	states: null;
};
static Switch layoutAlignBottom = {
	onUpdate: syncAlignment;
	text: "LayoutAlign.bottom";
	states: null;
};

static Switch itemAlignTop = {
	onUpdate: syncAlignment;
	text: "ItemAlign.top";
	states: null;
	selected: 1;
};
static Switch itemAlignLeft = {
	onUpdate: syncAlignment;
	text: "ItemAlign.left";
	states: null;
	selected: 1;
};
static Switch itemAlignRight = {
	onUpdate: syncAlignment;
	text: "ItemAlign.right";
	states: null;
	selected: 1;
};
static Switch itemAlignBottom = {
	onUpdate: syncAlignment;
	text: "ItemAlign.bottom";
	states: null;
	selected: 1;
};

static Switch textAlignTop = {
	onUpdate: syncAlignment;
	text: "TextAlign.top";
	states: null;
};
static Switch textAlignLeft = {
	onUpdate: syncAlignment;
	text: "TextAlign.left";
	states: null;
	selected: 1;
};
static Switch textAlignRight = {
	onUpdate: syncAlignment;
	text: "TextAlign.right";
	states: null;
};
static Switch textAlignBottom = {
	onUpdate: syncAlignment;
	text: "TextAlign.bottom";
	states: null;
};

// container for rectangles
static Layout layout = {
	enabled: false;
	focusable: false;
};

static Style style = {
	align: Style.center;
};

// container for controls
Widget widget = {
	width: 1440;
	height: 900;
	style: style;
	orientation: 0;
};

// create some custom views with a background color and a text
View Rectangle(uint32 rgb, char text[]) {
	struct Rectangle: Button {
		argb background;
		void onDraw^(Rectangle this, Image offs, Rect rect) {
			offs.fillRect(rect, this.background.v);
			Button.onDraw(this, offs, rect);
		}
	}
	return Rectangle {
		background: argb(rgb);
		enabled: false;
		text: text;
		width: itemSize;
		height: itemSize;
	};
}

Window.show(widget
	.focus(orientation)
	// add the layout to background
	.addItems(Style.center, layout.addItems(Style.center,
		Rectangle(0x101010, "1"),
		Rectangle(0x101040, "2"),
		Rectangle(0x104010, "3"),
		Rectangle(0x401010, "4"),
		Rectangle(0x104040, "5"),
		Rectangle(0x401040, "6"),
		Rectangle(0x404010, "7"),
		Rectangle(0x404040, "8")
	))
	.addItems(Style.right, Layout.Column(
		orientation,

		null,
		paddingTop,
		paddingLeft,
		paddingRight,
		paddingBottom,
		null,
		layoutAlignTop,
		layoutAlignLeft,
		layoutAlignRight,
		layoutAlignBottom,
		null,
		itemAlignTop,
		itemAlignLeft,
		itemAlignRight,
		itemAlignBottom,

		null,
		textAlignTop,
		textAlignLeft,
		textAlignRight,
		textAlignBottom
	))
);

bool syncOrientation(Slider this, float64 value) {
	if (!Slider.onUpdate(this, value)) {
		return false;
	}
	layout.orientation = this.value;
	layout.invalidate();
	return true;
}
static bool syncPadding(Slider this, float64 value) {
	if (!Slider.onUpdate(this, value)) {
		return false;
	}
	layout.paddingTop = paddingTop.value;
	layout.paddingLeft = paddingLeft.value;
	layout.paddingRight = paddingRight.value;
	layout.paddingBottom = paddingBottom.value;
	layout.invalidate();
	return true;
}
static bool syncAlignment(Switch this, int value) {
	if (!Switch.onUpdate(this, value)) {
		return false;
	}

	int textAlign = Style.center;
	if (textAlignTop.selected) {
		textAlign |= Style.top;
	}
	if (textAlignLeft.selected) {
		textAlign |= Style.left;
	}
	if (textAlignRight.selected) {
		textAlign |= Style.right;
	}
	if (textAlignBottom.selected) {
		textAlign |= Style.bottom;
	}

	// todo: hack to write constant value
	int align& = pointer(style.align);
	align = textAlign;

	int itemAlign = Style.center;
	if (itemAlignTop.selected) {
		itemAlign |= Style.top;
	}
	if (itemAlignLeft.selected) {
		itemAlign |= Style.left;
	}
	if (itemAlignRight.selected) {
		itemAlign |= Style.right;
	}
	if (itemAlignBottom.selected) {
		itemAlign |= Style.bottom;
	}
	for (int i = 0; i < layout.size(); i += 1) {
		layout.setAlignment(i, itemAlign);
	}

	if (Widget w = layout.parent().as(Widget)) {
		int layoutAlign = Style.center;
		if (layoutAlignTop.selected) {
			layoutAlign |= Style.top;
		}
		if (layoutAlignLeft.selected) {
			layoutAlign |= Style.left;
		}
		if (layoutAlignRight.selected) {
			layoutAlign |= Style.right;
		}
		if (layoutAlignBottom.selected) {
			layoutAlign |= Style.bottom;
		}
		assert(layout == w.getView(0), "layout should be the first view");
		w.setAlignment(0, layoutAlign);
	}

	layout.invalidate();
	return true;
}
