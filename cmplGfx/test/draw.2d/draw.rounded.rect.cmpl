// rounded rectangle demo

static Image offs = Image(800, 600, 32);

static Slider sldSx = {
	text: "size.x";
	maximum: offs.width() / 2;
	value: offs.width() / 4;
	stepSize: 1;
};
static Slider sldSy = {
	text: "size.y";
	maximum: offs.height() / 2;
	value: offs.height() / 4;
	stepSize: 1;
};
static Slider sldRx = {
	text: "round.x";
	maximum: sldSx.maximum;
	value: 20;
	stepSize: 1;
};
static Slider sldRy = {
	text: "round.y";
	maximum: sldSy.maximum;
	value: 20;
	stepSize: 1;
};
static DebugView debug = {
	focusable: false;
	measures: -1;
	draws: -1;
};
Button separator = {
	text: null;
	height: 1;
	enabled: false;
};

int32 onEvent(int32 action, int32 button, int32 x, int32 y) {
	if (action == Window.KEY_RELEASE && button == Window.KEY_CODE_ESC) {
		// exit when releasing escape key
		return Window.quit();
	}
	if (action < Window.EVENT_PROCESSED) {
		// action was not processed by the widget, do not redraw
		return Window.timeoutMax;
	}

	debug.startTimer();
	offs.fill(0);
	int x = offs.width() / 2;
	int y = offs.height() / 2;
	int sx = sldSx.value;
	int sy = sldSy.value;
	int rx = sldRx.value;
	int ry = sldRy.value;
	offs.fillRRect(x - sx, y - sy, x + sx, y + sy, rx, ry, 0xffffff);
	return Window.timeoutMax;
}
Window.show(offs, onEvent, FxWidget(
	sldSx, sldSy, sldRx, sldRy,
	separator, debug
));
offs.destroy();
