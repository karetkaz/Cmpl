inline dark = !false;
inline cBack = dark ? 0x1d1e21 : 0xffffff;
inline cGrid = dark ? 0x3d3e41 : 0xdadada;
inline cThis = dark ? 0x00ffff : 0x0000ff;  // color of function approximated here
inline cMath = dark ? 0x00ff00 : 0x00ff00;  // color of function plotted using Math
inline cErr = 0xd0ff0000;
inline cText = cBack ^ 0xffffff;

inline grid = 5;
inline zoom = 1;

inline h = 960;
inline w = h * 16 / 9;
static Image offs = Image(w, h, 32);
static Image gr = zoom <= 1 ? offs : Image(w / zoom, h / zoom, 32);

// Functions is not defined, compare Float64 vs Float32
static if (struct(Functions) != typename) {
struct Functions {
	static float64 minimum = -149;
	static float64 maximum = 130;

	char text[];
	float64 base(float64 x);
	float32 test(float32 x);
	static float64 test(Functions fn, float64 x) {
		return fn.test(x);
	}

	static float32 Float32_nan(float32 x) { return Float32.nan; }

	static float32 floor(float32 x) = Float32.floor;
	static float32 round(float32 x) { return Float32.round(x); }
	static float32 ceil(float32 x) { return Float32.ceil(x); }
	static float32 sqrt(float32 x) = Float32.sqrt;
	static float32 ln(float32 x) = Float32.ln;
	static float32 log2(float32 x) = Float32.log2;
	static float32 exp(float32 x) = Float32.exp;
	static float32 exp2(float32 x) = Float32_nan;
	static float32 sin(float32 x) = Float32.sin;
	static float32 asin(float32 x) { return Float32.asin(x); }
	static float32 sinh(float32 x) = Float32_nan;
	static float32 asinh(float32 x) = Float32_nan;
	static float32 cos(float32 x) = Float32.cos;
	static float32 acos(float32 x) { return Float32.acos(x); }
	static float32 cosh(float32 x) = Float32_nan;
	static float32 acosh(float32 x) = Float32_nan;
	static float32 tan(float32 x) = Float32.tan;
	static float32 atan(float32 x) { return Float32.atan(x); }
	static float32 tanh(float32 x) = Float32_nan;
	static float32 atanh(float32 x) = Float32_nan;
	static float32 sec(float32 x) = Float32_nan;
	static float32 asec(float32 x) = Float32_nan;
	static float32 sech(float32 x) = Float32_nan;
	static float32 asech(float32 x) = Float32_nan;
	static float32 csc(float32 x) = Float32_nan;
	static float32 acsc(float32 x) = Float32_nan;
	static float32 csch(float32 x) = Float32_nan;
	static float32 acsch(float32 x) = Float32_nan;
	static float32 cot(float32 x) = Float32_nan;
	static float32 acot(float32 x) = Float32_nan;
	static float32 coth(float32 x) = Float32_nan;
	static float32 acoth(float32 x) = Float32_nan;
}
} else {
// TODO: add missing methods if any
// static if (struct(Functions.exp) == null) {static struct Functions { static function exp = null; }}
}
Functions functions[] = {
	{base: Float64.floor, test: Functions.floor, text: "floor" },
	{base: Float64.round, test: Functions.round, text: "round" },
	{base: Float64.ceil, test: Functions.ceil, text: "ceil" },
	{base: Float64.sqrt, test: Functions.sqrt, text: "sqrt" },

	{base: Float64.ln, test: Functions.ln, text: "ln" },
	{base: Float64.log2, test: Functions.log2, text: "log2" },
	{base: Float64.exp, test: Functions.exp, text: "exp" },
	{base: Float64.exp2, test: Functions.exp2, text: "exp2" },

	{base: Float64.sin, test: Functions.sin, text: "sin" },
	{base: Float64.asin, test: Functions.asin, text: "asin" },
	{base: Float64.sinh, test: Functions.sinh, text: "sinh" },
	{base: Float64.asinh, test: Functions.asinh, text: "asinh" },

	{base: Float64.cos, test: Functions.cos, text: "cos" },
	{base: Float64.acos, test: Functions.acos, text: "acos" },
	{base: Float64.cosh, test: Functions.cosh, text: "cosh" },
	{base: Float64.acosh, test: Functions.acosh, text: "acosh" },

	{base: Float64.tan, test: Functions.tan, text: "tan" },
	{base: Float64.atan, test: Functions.atan, text: "atan" },
	{base: Float64.tanh, test: Functions.tanh, text: "tanh" },
	{base: Float64.atanh, test: Functions.atanh, text: "atanh" },

	{base: Float64.sec, test: Functions.sec, text: "sec" },
	{base: Float64.asec, test: Functions.asec, text: "asec" },
	{base: Float64.sech, test: Functions.sech, text: "sech" },
	{base: Float64.asech, test: Functions.asech, text: "asech" },

	{base: Float64.csc, test: Functions.csc, text: "csc" },
	{base: Float64.acsc, test: Functions.acsc, text: "acsc" },
	{base: Float64.csch, test: Functions.csch, text: "csch" },
	{base: Float64.acsch, test: Functions.acsch, text: "acsch" },

	{base: Float64.cot, test: Functions.cot, text: "cot" },
	{base: Float64.acot, test: Functions.acot, text: "acot" },
	{base: Float64.coth, test: Functions.coth, text: "coth" },
	{base: Float64.acoth, test: Functions.acoth, text: "acoth" },
};

static Select chkFunctions = {
	text: "function";
	focusable: true;
	orientation: 4;
};
static Slider sldScale = {
	text: "scale (2 ** x)";
	minimum: Functions.minimum;
	maximum: Functions.maximum;
	value: 2;
};
static Slider sldXOffset = {
	text: "offset.x";
	minimum: -Float64.inf;
	maximum: +Float64.inf;
};
static Slider sldYOffset = {
	text: "offset.y";
	minimum: -Float64.inf;
	maximum: +Float64.inf;
};
static Switch chkCenterY = {
	text: "center y";
	states: null;
	selected: 1;
	clickToFocus: false;
};
static Switch chkDisplay = {
	static char statesDisplay[][4] = {
		"diff",
		"error",
		"native",
		"computed",
	};
	text: "display";
	states: statesDisplay;
	clickToFocus: false;
};
static Switch chkSmooth = {
	text: "smooth";
	states: null;
	clickToFocus: false;
};

static DebugView debug = {
	focusable: false;
	measures: -1;
	draws: -1;
	width: 200;
};

void aaLine(Image img, int32 x, float64 y0, float64 y1, uint32 color) {
	inline mix(Image image, int x0, int y0, int alpha, uint32 color) = image.set(x0, y0, mix_rgb8(alpha, argb(uint32(image.get(x0, y0))), argb(color)));
	int32 sign = 1;
	if (y0 > y1) {
		float64 y = y0;
		y0 = y1;
		y1 = y;
		sign = -1;
	}

	if (y0 < 0) { y0 = 0; }
	if (y1 > img.height()) { y1 = img.height(); }
	if (y1 < 0 || y0 > img.height()) {
		return;
	}

	if (chkSmooth.selected == 0) {
		return img.fillRect(x, y0, x+1, Float64.max(y1, y0 + 1), 0, color);
	}

	if (y1 - y0 < 1) {
		int a0 = int32(y0 * 256) & 0xff;
		int a1 = int32(y1 * 256) & 0xff;
		img.mix(x, y0, 255 - a0, color);
		img.mix(x, y0 + 1, a0, color);
		return;
	}

	float64 dx = 1 / (y1 - y0);
	int32 iy0 = int32(y0);
	int32 iy1 = int32(y1);
	if (float64(iy1) >= y1) { iy1 -= 1; }
	for (int32 yi = iy0; yi <= iy1; yi += 1) {
		float64 yTop = y0;
		if (yi > iy0) { yTop = float64(yi); }
		float64 yBot = y1;
		if (yi < iy1) { yBot = float64(yi + 1); }
		int32 a = int32(((yTop + yBot) / 2 - y0) * dx * 256) & 255;
		img.mix(x + sign, yi, a, color);
		img.mix(x, yi, 255 - a, color);
	}
}

int32 onEvent(int32 action, int32 button, int32 x, int32 y) {
	if (action == Window.KEY_RELEASE && button == Window.KEY_CODE_ESC) {
		// exit when releasing escape key
		return Window.quit();
	}
	if (action < Window.EVENT_PROCESSED) {
		// action was not processed by the widget, do not redraw
		return Window.timeoutMax;
	}

	Functions fn? = chkFunctions.selectedData().as(Functions);
	if (fn == null) {
		return Window.timeoutMax;
	}

	debug.startTimer();

	float64 width = gr.width();
	float64 xScale = Float64.exp2(sldScale.value);
	float64 xStart = -sldXOffset.value;

	if (chkCenterY.selected) {
		float64 y = fn.base(xStart);
		if (Float64.isFinite(y)) {
			sldYOffset.onUpdate(-y);
		}
	}

	float64 height = gr.height();
	float64 yScale = xScale / width * height;
	float64 yStart = -sldYOffset.value;

	float64 yGood[w / zoom + 1] = {0};
	float64 yComp[w / zoom + 1] = {0};

	sldXOffset.shiftFactor = offs.width() / xScale / 2;
	sldYOffset.shiftFactor = offs.height() / yScale / 2;
	for (int64 i = 0; i < yGood.length; i += 1) {
		float64 x = xStart + xScale * (i - width / 2) / width * 2;
		yGood[i] = fn.base(x);
		yComp[i] = Functions.test(fn, x);
	}

	if (chkDisplay.selected == 1) {
		float64 yMin = +Float64.inf;
		float64 yMax = -Float64.inf;
		for (int64 i = 0; i < yGood.length; i += 1) {
			float64 y = yGood[i] - yComp[i];
			yGood[i] = 0;
			yComp[i] = y;
			if (Float64.isFinite(y)) {
				if (yMin > y) {
					yMin = y;
				}
				if (yMax < y) {
					yMax = y;
				}
			}
		}

		static if (!false) {
			// center error on screen
			if (yMax < -yMin) {
				yMax = -yMin;
			} else {
				yMin = -yMax;
			}
		}

		if (yMax == 0 && yMin == 0) {
			yMin = -(yMax = 1e-300);
		}

		yScale = (yMax - yMin) / 2;
		yStart = yMin + yScale;

		// add some pixel padding
//		yScale += 5. / height;

		// restrict y scaling only to grow, but not to shrink
		yScale = Float64.min(yScale, xScale / width * height);
	}

	if (cErr != -1) {
		uint32 cErr1 = uint32(mix_rgb8(ach(argb(cErr)), argb(cErr), argb(cBack)));
		uint32 cErr2 = uint32(mix_rgb8(ach(argb(cErr)), argb(cErr1), argb(cBack)));
		uint32 errColor = cBack;
		int errStart = 0;
		for (int64 i = 0; i < yGood.length; i += 1) {
			bool badGood = !Float64.isFinite(yGood[i]);
			bool badComp = !Float64.isFinite(yComp[i]);
			uint32 newColor = cBack;
			if (badGood || badComp) {
				if (badComp == badGood) {
					newColor = cErr2;
				} else {
					newColor = cErr1;
				}
			}

			if (errColor != newColor) {
				gr.fillRect(errStart, 0, i, height, 0, errColor);
				errColor = newColor;
				errStart = i - 0;
			}
		}
		gr.fillRect(errStart, 0, yGood.length, height, 0, errColor);
	} else {
		gr.fill(cBack);
	}
	static if (zoom <= 1 && grid > 1) {
		float64 logStep = Float64.floor(Float64.log(xScale, grid));
		float64 step = Float64.pow(float64(grid), logStep);
		float64 alpha = (xScale - step) / (Float64.pow(float64(grid), logStep + 1) - step);
		uint32 cBar1 = uint32(mix_rgb8(128, argb(cGrid), argb(cBack)));
		uint32 cBar2 = uint32(mix_rgb8(int32(255 * alpha), argb(cBar1), argb(cBack)));

		float64 cx = w / 2 - (xStart % step) * w / 2 / xScale;
		float64 cy = h / 2 + (yStart % step) * h / 2 / yScale;
		for (float64 i = 0; i < grid * grid; i += 1) {
			float64 x = i * w / 2 / xScale * (step / grid);
			float64 y = i * h / 2 / yScale * (step / grid);
			offs.fillRect(cx + x, 0, cx + x, w, 1, cBar2);
			offs.fillRect(cx - x, 0, cx - x, w, 1, cBar2);
			offs.fillRect(0, cy + y, w, cy + y, 1, cBar2);
			offs.fillRect(0, cy - y, w, cy - y, 1, cBar2);
		}
		for (float64 i = 0; i < grid; i += 1) {
			float64 x = i * w / 2 / xScale * step;
			float64 y = i * h / 2 / yScale * step;
			offs.fillRect(cx + x, 0, cx + x, w, 1, cBar1);
			offs.fillRect(cx - x, 0, cx - x, w, 1, cBar1);
			offs.fillRect(0, cy + y, w, cy + y, 1, cBar1);
			offs.fillRect(0, cy - y, w, cy - y, 1, cBar1);
		}
		float64 x = w / 2 - xStart * w / 2 / xScale;
		float64 y = h / 2 + yStart * h / 2 / yScale;
		offs.fillRect(x - 1, 0, x - 1, h, 1, cGrid);
		offs.fillRect(0, y - 1, w, y - 1, 1, cGrid);

		// the real center on the screen
		offs.fillRect(w / 2 - 1, 0, w / 2 - 1, h, 1, cGrid);
		offs.fillRect(0, h / 2 - 1, w, h / 2 - 1, 1, cGrid);

		NumberFormat fmt = {
			positiveSymbol: '+';	// force sign symbol
			trailingZeros: true;
			groupingSymbol: ' ';
			precision: 9;
		};
		char text[1024] = {...};
		Rect rect = {};
		int p = 0;

		p = text.append(0, "Center: (");
		p = fmt.format(text, p, xStart);
		p = text.append(p, ", ");
		p = fmt.format(text, p, yStart);
		p = text.append(p, ")");
		Window.font.clipText(&rect, text);
		rect.position(10, offs.height() - rect.height() - 10);
		offs.fillRect(rect, cBar1);
		offs.drawText(rect, Window.font, text, cText);

		p = text.append(0, "y: (");
		p = fmt.format(text, p, yStart - yScale);
		p = text.append(p, ", ");
		p = fmt.format(text, p, yStart + yScale);
		p = text.append(p, "): 2 ** ");
		p = fmt.format(text, p, Float64.log2(2 * yScale));
		Window.font.clipText(&rect, text);
		rect.position(10,  10);
		offs.fillRect(rect, cBar1);
		offs.drawText(rect, Window.font, text, cText);

		p = text.append(0, "x: (");
		p = fmt.format(text, p, xStart - xScale);
		p = text.append(p, ", ");
		p = fmt.format(text, p, xStart + xScale);
		p = text.append(p, "): 2 ** ");
		p = fmt.format(text, p, Float64.log2(2 * xScale));

		Window.font.clipText(&rect, text);
		rect.position(offs.width() - rect.width() - 10, offs.height() - rect.height() - 10);
		offs.fillRect(rect, cBar1);
		offs.drawText(rect, Window.font, text, cText);
	}

	if (chkDisplay.selected != 2) {
		float64 prev = height / 2 - (yComp[0] - yStart) * height / 2 / yScale;
		for (int64 i = 0; i < yGood.length - 1; i += 1) {
			float64 next = height / 2 - (yComp[i + 1] - yStart) * height / 2 / yScale;
			if (Float64.isFinite(next) && Float64.isFinite(prev)) {
				gr.aaLine(i, prev, next, cThis);
			}
			prev = next;
		}
	}

	if (chkDisplay.selected != 3) {
		float64 prev = height / 2 - (yGood[0] - yStart) * height / 2 / yScale;
		for (int64 i = 0; i < yGood.length - 1; i += 1) {
			float64 next = height / 2 - (yGood[i + 1] - yStart) * height / 2 / yScale;
			if (Float64.isFinite(next) && Float64.isFinite(prev)) {
				gr.aaLine(i, prev, next, cMath);
			}
			prev = next;
		}
	}

	static if (zoom > 1) {
		offs.transform(null, gr, null, 0);
	}

	return Window.timeoutMax;
}

for (int i = 0; i < functions.length; i += 1) {
	Functions fn! = functions[i];
	chkFunctions.addItem(fn.text, fn);
}
Window.show(offs, onEvent, FxWidget(
	chkFunctions.setSelectedIndex(8),
	sldScale,
	sldXOffset,
	sldYOffset,
	chkCenterY,
	chkDisplay,
	chkSmooth,
	null, debug
).focus(sldScale));
