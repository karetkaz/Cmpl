/* Blur, sharpen and blend images with alpha mask
 *
 * use 'tab' / 'shift' + 'tab' to select next control
 * use 'enter' / 'shift' + 'enter' to select next control
 * use '+' / '-' to adjust value of selected control (use shift for more precision)
 * use 'backspace' / 'shift' + 'backspace' to reset selected / every control value
 * use 'space' to press a button, toggle switch or reset slider value
 * use '[' or ']' to show and hide the controls
 *
 * drag the mouse to move the rectangle of the mask, use shift to resize it
 * drag the mouse left or right in the window to adjust selected slider value
 */

static Image surf = Image("../asset/image/forest.jpg", 32);
static Image offs = Image(surf);
static Image blur = Image(surf);

static View.State onTouchEvent(Button view, Rect rect!, TouchEvent event!);
static void onResetClick(Button view, int32 clicks);
static Histogram histogram = {
	enabled: false,
};

static Slider sldBlur = {
	text: "Blur",
	value: 20,
	minimum: .3,
	maximum: 20,
};
static Slider sldSharpness = {
	text: "Sharp",
	value: 2,
	minimum: 0,
	maximum: 4,
};

static Button btnLinear = {
	text: "Linear",
	onTouchEvent: onTouchEvent,
};
static Button btnReflect = {
	text: "Reflect",
	onTouchEvent: onTouchEvent,
};
static Button btnSquare = {
	text: "Square",
	onTouchEvent: onTouchEvent,
};
static Button btnRadial = {
	text: "Radial",
	onTouchEvent: onTouchEvent,
};

static Slider sldHardness = {
	text: "Hardness",
	minimum: -255,
	maximum: 255,
	stepSize: 1,
	focusable: false,
};
static Slider sldAlpha = {
	text: "Alpha",
	minimum: -255,
	maximum: 255,
	value: 255,
	stepSize: 1,
	focusable: false,
};
static char scaleMove[][] = {
	"Move",
	"Scale"
};
static Switch chkMoveScale = {
	states: scaleMove,
	text: "Drag mode",
	focusable: false,
};
static Switch chkRect = {
	text: "Show rect",
	focusable: false,
};
static Switch chkMask = {
	text: "Show mask",
	focusable: false,
};
static Button btnReset = {
	text: "Reset rect",
	focusable: false,
	onClick: onResetClick,
};
static Panel panMask = {
	visible: false,
};

static DebugView debug = {
	focusable: false,
	measures: -1,
	draws: -1,
};

//inline blur(Image surf, int radius) = surf.blur(radius, 0.3 * (radius - 1) + 0.8);
inline blur(Image surf, float64 sigma) = surf.blur(Float64.max(1., (sigma - 0.8) / 0.3 + 1), sigma);

static Rect rect = {
	x0: 0,
	y0: 0,
	x1: offs.width(),
	y1: offs.height(),
};
static float64 oldRadius = 0;

int32 onEvent(int32 action, int32 button, int32 x, int32 y) {
	if (action == Window.KEY_RELEASE && button == Window.KEY_CODE_ESC) {
		// exit when releasing escape key
		return Window.quit();
	}
	if (action < Window.EVENT_PROCESSED) {
		// action was not processed by the widget, do not redraw
		return Window.timeoutMax;
	}

	debug.startTimer();
	Widget widget = debug.getWidget();
	if (FxWidget.showOriginal(widget)) {
		offs.copy(0, 0, surf, null);
		histogram.update(offs);
		return Window.timeoutMax;
	}

	if (!sldBlur.isPressed()) {
		if (oldRadius != sldBlur.value) {
			oldRadius = sldBlur.value;
			blur.copy(0, 0, surf, null);
			blur.blur(sldBlur.value);
		}
	}

	// apply blur from cached image
	offs.copy(0, 0, blur, null);

	if (widget.hasFocused(btnLinear, btnReflect, btnRadial, btnSquare)) {
		uint32 colors[512] = {...?};

		if (chkMask.selected) {
			offs.fill(0xff0000);
		}
		if (btnReflect.isFocused()) {
			alphaLut(&colors, sldHardness.value, sldAlpha.value, true);
			offs.gradient(rect, gradient.MaskLinear, false, ...colors);
		}
		else if (btnLinear.isFocused()) {
			alphaLut(&colors, sldHardness.value, sldAlpha.value, false);
			offs.gradient(rect, gradient.MaskLinear, false, ...colors);
		}
		else if (btnRadial.isFocused()) {
			alphaLut(&colors, sldHardness.value, sldAlpha.value, false);
			offs.gradient(rect, gradient.MaskRadial, false, ...colors);
		}
		else if (btnSquare.isFocused()) {
			alphaLut(&colors, sldHardness.value, sldAlpha.value, false);
			offs.gradient(rect, gradient.MaskSquare, false, ...colors);
		}

		offs.blendDstAlpha(0, 0, surf, null);
		if (chkRect.selected) {
			int x0 = rect.x0;
			int x1 = rect.x1;
			int y0 = rect.y0;
			int y1 = rect.y1;
			offs.drawRect(x0, y0, x1, y1, 0x00ff00);
			offs.drawLine(x0, y0, x1, y1, 0xff0000);
		}
		panMask.visible(true);
	} else {
		offs.blendAlpha(0, 0, surf, null, 255 * sldSharpness.value);
		panMask.visible(false);
	}

	histogram.update(offs);
	return Window.timeoutMax;
}
View.State onTouchEvent(Button view, Rect r!, TouchEvent event!) {
	View.State result = Button.onTouchEvent(view, r, event);
	if (result != View.State.ignored || event.button == 0) {
		return result;
	}
	if (view.isPressed()) {
		return result;
	}

	// resize
	if (event.isAlt || chkMoveScale.selected == 2) {
		rect.adjust(0, 0, event.dx, event.dy);
		return View.State.handled;
	}
	// move
	if (event.isShift == bool(chkMoveScale.selected)) {
		rect.translate(event.dx, event.dy);
		return View.State.handled;
	}

	// resize while the center of the rect is pinned
	rect.adjust(-event.dx, -event.dy, event.dx, event.dy);
	return View.State.handled;
}
void onResetClick(Button view, int32 clicks) {
	rect.x0 = 0;
	rect.y0 = 0;
	rect.x1 = offs.width();
	rect.y1 = offs.height();
}

Window.show(offs, onEvent, FxWidget(
	histogram,
	null, sldBlur, sldSharpness,
	null, btnLinear, btnReflect, btnSquare, btnRadial,
	panMask.addItems(Style.fill,
		null, sldAlpha, sldHardness, chkMoveScale, chkMask, chkRect, btnReset
	),
	null, debug
));
blur.destroy();
offs.destroy();
surf.destroy();
