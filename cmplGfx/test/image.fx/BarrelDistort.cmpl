/* Barrel / pincushion lens distortion, usable for camera lens correction.
 *
 * Radial distortion model (Brown-Conrady):
 *   r' = r * (1 + k1*r^2 + k2*r^4 + k3*r^6)
 * every destination pixel samples the source at the distorted radius (inverse mapping),
 * so positive coefficients produce a barrel effect, negative ones a pincushion effect.
 * To correct a distorted photo, use coefficients of the opposite sign of the lens.
 *
 * use 'tab' / 'shift' + 'tab' to select next control
 * use 'enter' / 'shift' + 'enter' to select next control
 * use '+' / '-' to adjust value of selected control (use shift for more precision)
 * use 'backspace' / 'shift' + 'backspace' to reset selected / every control value
 * use 'space' to press a button, toggle switch or reset slider value
 * use '[' or ']' to show and hide the controls
 *
 * drag the mouse left or right in the window to adjust selected slider value
 */

static Image back = Image("../asset/image/forest.jpg", 32);
static Image offs = Image(back);

// source with a grid overlay to visualize how straight lines are bent
static Image grid = Image(back);
for (int x = 0; x < grid.width(); x += 40) {
	grid.fillRect(x, 0, x, grid.height(), 1, 0x00ff00);
}
for (int y = 0; y < grid.height(); y += 40) {
	grid.fillRect(0, y, grid.width(), y, 1, 0x00ff00);
}

static char filtering[][] = {
	"nearest",
	"linear",
};
static Switch quality = {
	text: "filtering";
	states: filtering;
	selected: 1;
	focusable: false;
};
static Switch showGrid = {
	text: "show grid";
	focusable: false;
};
static Slider k1 = {
	text: "k1 (r^2)";
	minimum: -1;
	maximum: +1;
};
static Slider k2 = {
	text: "k2 (r^4)";
	minimum: -1;
	maximum: +1;
};
static Slider k3 = {
	text: "k3 (r^6)";
	minimum: -1;
	maximum: +1;
};
static Slider zoom = {
	text: "zoom";
	value: 1;
	minimum: .25;
	maximum: 4;
};
static Slider centerX = {
	text: "center x";
	minimum: -.5;
	maximum: +.5;
};
static Slider centerY = {
	text: "center y";
	minimum: -.5;
	maximum: +.5;
};
static DebugView debug = {
	focusable: false;
	measures: -1;
	draws: -1;
};

int32 onEvent(int32 action, int32 button, int32 x, int32 y) {
	if (action == Window.KEY_RELEASE && button == Window.KEY_CODE_ESC) {
		// exit when releasing escape key
		return Window.quit();
	}
	if (action < Window.EVENT_PROCESSED) {
		// action was not processed by the widget, do not redraw
		return Window.timeoutMax;
	}

	debug.startTimer();
	Image src = showGrid.selected != 0 ? grid : back;
	if (FxWidget.showOriginal(debug.getWidget())) {
		offs.copy(0, 0, src, null);
		return Window.timeoutMax;
	}

	int width = offs.width();
	int height = offs.height();
	float64 cx = width * (.5 + centerX.value);
	float64 cy = height * (.5 + centerY.value);

	// normalize radius so the farthest corner is at r = 1
	float64 dx = Float64.max(cx, width - cx);
	float64 dy = Float64.max(cy, height - cy);
	float64 radius = Float64.sqrt(dx * dx + dy * dy);

	float64 c1 = k1.value;
	float64 c2 = k2.value;
	float64 c3 = k3.value;
	float64 invZoom = 1 / zoom.value;
	bool linear = quality.selected != 0;
	float64 texX = 1 / float64(width);
	float64 texY = 1 / float64(height);

	for (int py = 0; py < height; py += 1) {
		float64 ny = (py - cy) / radius;
		for (int px = 0; px < width; px += 1) {
			float64 nx = (px - cx) / radius;
			float64 r2 = nx * nx + ny * ny;
			float64 f = invZoom * (1 + r2 * (c1 + r2 * (c2 + r2 * c3)));
			float64 sx = cx + nx * f * radius;
			float64 sy = cy + ny * f * radius;
			if (sx < 0 || sy < 0 || sx >= width || sy >= height) {
				// sample falls outside the source image
				offs.set(px, py, argb(0x000000));
				continue;
			}
			if (linear) {
				offs.set(px, py, argb(src.tex(float32(sx * texX), float32(sy * texY))));
			} else {
				offs.set(px, py, argb(uint32(src.get(int32(sx + .5), int32(sy + .5)))));
			}
		}
	}
	return Window.timeoutMax;
}

Window.show(offs, onEvent, FxWidget(
	quality, showGrid,
	k1, k2, k3,
	zoom,
	centerX, centerY,
	null, debug
));
grid.destroy();
offs.destroy();
back.destroy();

