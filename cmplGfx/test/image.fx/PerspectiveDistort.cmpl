/* Perspective distortion, usable for keystone correction.
 *
 * The image plane is rotated in 3d around its center (pitch, yaw, roll),
 * then projected back with a pinhole camera model. The mapping is a
 * homography: H = K * R^-1 * K^-1, applied inverse (every destination
 * pixel computes its source position with a perspective divide).
 * The matrix is passed to Image.transform, which detects the homogeneous
 * w row and switches to its perspective implementation.
 * To correct a keystoned photo (e.g. a projector or a tilted camera),
 * apply the opposite tilt.
 *
 * use 'tab' / 'shift' + 'tab' to select next control
 * use 'enter' / 'shift' + 'enter' to select next control
 * use '+' / '-' to adjust value of selected control (use shift for more precision)
 * use 'backspace' / 'shift' + 'backspace' to reset selected / every control value
 * use 'space' to press a button, toggle switch or reset slider value
 * use '[' or ']' to show and hide the controls
 *
 * drag the mouse left or right in the window to adjust selected slider value
 */

static Image back = Image("../asset/image/forest.jpg", 32);
static Image offs = Image(back);

// source with a grid overlay to visualize how the perspective changes
static Image grid = Image(back);
for (int x = 0; x < grid.width(); x += 40) {
	grid.fillRect(x, 0, x, grid.height(), 1, 0x00ff00);
}
for (int y = 0; y < grid.height(); y += 40) {
	grid.fillRect(0, y, grid.width(), y, 1, 0x00ff00);
}

static char filtering[][] = {
	"nearest",
	"linear",
};
static Switch quality = {
	text: "filtering",
	states: filtering,
	selected: 1,
	focusable: false,
};
static Switch showGrid = {
	text: "show grid",
	focusable: false,
};
static Switch recenter = {
	text: "recenter",
	selected: 1,
	focusable: false,
};
static Slider tiltX = {
	text: "tilt x (pitch)",
	minimum: -60,
	maximum: +60,
};
static Slider tiltY = {
	text: "tilt y (yaw)",
	minimum: -60,
	maximum: +60,
};
static Slider rotate = {
	text: "rotate (roll)",
	minimum: -180,
	maximum: +180,
};
static Slider fov = {
	text: "fov",
	value: 60,
	minimum: 20,
	maximum: 120,
};
static Slider zoom = {
	text: "zoom",
	value: 1,
	minimum: .25,
	maximum: 4,
};
static Slider translateX = {
	text: "translate x",
	minimum: -offs.width(),
	maximum: +offs.width(),
};
static Slider translateY = {
	text: "translate y",
	minimum: -offs.height(),
	maximum: +offs.height(),
};
static DebugView debug = {
	focusable: false,
	measures: -1,
	draws: -1,
};

int32 onEvent(int32 action, int32 button, int32 x, int32 y) {
	if (action == Window.KEY_RELEASE && button == Window.KEY_CODE_ESC) {
		// exit when releasing escape key
		return Window.quit();
	}
	if (action < Window.EVENT_PROCESSED) {
		// action was not processed by the widget, do not redraw
		return Window.timeoutMax;
	}

	debug.startTimer();
	Image src = showGrid.selected != 0 ? grid : back;
	if (FxWidget.showOriginal(debug.getWidget())) {
		offs.copy(0, 0, src, null);
		return Window.timeoutMax;
	}

	int width = offs.width();
	int height = offs.height();
	float32 cx = width * .5;
	float32 cy = height * .5;

	// pinhole camera: focal length in pixels from the field of view
	// (same formula as Camera.projection, so the two cancel exactly at identity)
	float32 focal = .5 * width / Float32.tan(Float32.radians(fov.value) / 2);

	// destination pixel -> ray through the camera center: (x - cx, y - cy, focal)
	mat4f unproject = translation(vec4f(-cx, -cy, focal, 0), 1);

	// inverse rotation: R^-1 = Rx(-pitch) * Ry(-yaw) * Rz(-roll)
	mat4f rot = rotation(vec4f(1, 0, 0, 0), -Float64.radians(tiltX.value))
		.mul(rotation(vec4f(0, 1, 0, 0), -Float64.radians(tiltY.value)))
		.mul(rotation(vec4f(0, 0, 1, 0), -Float64.radians(rotate.value)));

	// project the rotated ray back to the image plane; the w row makes
	// Image.transform divide by z (homography H = K * R^-1 * K^-1, up to scale);
	// scale builds the reciprocal: inverse mapping magnifies by sampling less
	mat4f mat = Camera.projection(fov.value, width, height)
		.mul(scale(vec4f(zoom.value, zoom.value, 1, 0), 1))
		.mul(rot)
		.mul(unproject);

	if (recenter.selected != 0) {
		// keep the image center fixed: translate in source space
		// so the destination center samples the source center
		vec4f c = mat.transform(cx, cy);
		mat = translation(vec4f(cx - c.x / c.w, cy - c.y / c.w, 0, 0), 1).mul(mat);
	}

	// translate in source space, after recenter (recenter would undo it)
	mat = translation(vec4f(translateX.value, translateY.value, 0, 0), 1).mul(mat);
	offs.transform(null, src, mat, quality.selected);
	return Window.timeoutMax;
}

Window.show(offs, onEvent, FxWidget(
	quality, showGrid, recenter,
	tiltX, tiltY, rotate,
	fov, zoom,
	translateX, translateY,
	null, debug
));
grid.destroy();
offs.destroy();
back.destroy();

/* References:
https://en.wikipedia.org/wiki/Homography_(computer_vision)
https://en.wikipedia.org/wiki/Keystone_effect
https://docs.opencv.org/4.x/d9/dab/tutorial_homography.html
Generated by Claude code / Fable 5
*/
