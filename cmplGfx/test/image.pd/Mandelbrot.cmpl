// procedural draw demo ~ Mandelbrot

static float64 size = 1.5;
static float64 xMin = -.5;
static float64 yMin = 0;
static argb colors[24] = {};

vec4f mandel(vec4f in) {
	Complex c = {
		re: xMin + Float64.mix(-size, size, float64(in.x)),
		im: yMin + Float64.mix(-size, size, float64(in.y)),
	};

	Complex z = Complex(0, 0);
	for (int i = 0; i < colors.length; i += 1) {
		z = z.mul(z).add(c);
		if (z.re * z.re + z.im * z.im >= 4) {
			return vec4f(colors[i]);
		}
	}
	return vec4f(1, 1, 1);
}

lerpLut(&colors, argb(0x000020), argb(0xffffff));
Window.show(512, 512, mandel);
