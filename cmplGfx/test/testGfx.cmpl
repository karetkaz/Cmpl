// test the generated events

static int onEvent(int action, int button, int x, int y);
static Image image = Image(512, 512, 32);
Window.show(image, onEvent);
image.destroy();

static int onEvent(int action, int button, int x, int y) {
	char actionName[] = null;
	int unicode = 0;
	if (action == Window.KEY_PRESS) {
		actionName = "KEY_PRESS";
		unicode = x;
	}
	else if (action == Window.KEY_RELEASE) {
		actionName = "KEY_RELEASE";
		unicode = x;
	}
	else if (action == Window.MOUSE_PRESS) {
		actionName = "MOUSE_PRESS";
	}
	else if (action == Window.MOUSE_MOTION) {
		actionName = "MOUSE_MOTION";
	}
	else if (action == Window.MOUSE_RELEASE) {
		actionName = "MOUSE_RELEASE";
	}
	else if (action == Window.FINGER_PRESS) {
		actionName = "FINGER_PRESS";
	}
	else if (action == Window.FINGER_MOTION) {
		actionName = "FINGER_MOTION";
	}
	else if (action == Window.FINGER_RELEASE) {
		actionName = "FINGER_RELEASE";
	}
	else if (action == Window.EVENT_TIMEOUT) {
		actionName = "EVENT_TIMEOUT";
	}
	else if (action == Window.GESTURE_SCROLL) {
		actionName = "GESTURE_SCROLL";
	}
	else if (action == Window.WINDOW_INIT) {
		actionName = "WINDOW_INIT";
	}
	else if (action == Window.WINDOW_CLOSE) {
		actionName = "WINDOW_CLOSE";
	}
	else if (action == Window.WINDOW_ENTER) {
		actionName = "WINDOW_ENTER";
	}
	else if (action == Window.WINDOW_LEAVE) {
		actionName = "WINDOW_LEAVE";
	}

	struct Event {
		char actionName[*];
		int action = action;
		int button = button;
		char key = unicode;
		int x = x;
		int y = y;
	}
	Event event = { actionName: actionName };
	debug("event", event);
	if (action == Window.KEY_RELEASE && button == Window.KEY_CODE_ESC) {
		return Window.quit();
	}

	static if (true) {
		static char actionText[32] = {0};
		static char keyText[32] = {0};
		static Button btnAction = {
			enabled: false,
			text: actionText,
			width: 192,
		};
		static Slider sldAction = {
			onDrawSlider: null,
			enabled: false,
			text: "action",
			stepSize: 1,
		};
		static Slider sldButton = {
			onDrawSlider: null,
			enabled: false,
			text: "button",
			stepSize: 1,
		};
		static Slider sldX = {
			onDrawSlider: null,
			enabled: false,
			text: "x",
			stepSize: 1,
		};
		static Slider sldY = {
			onDrawSlider: null,
			enabled: false,
			text: "y",
			stepSize: 1,
		};
		static Style style! = {
			font: Image.openTtf("asset/font/NokiaPureText.ttf", 60),
			align: Style.center,
		};
		static Button btnKey = {
			enabled: false,
			text: keyText,
			style: style,
		};
		static FxWidget ui = FxWidget(
			btnAction,
			sldAction,
			sldButton,
			sldX,
			sldY,
			btnKey
		);
		static Rect rect = {
			x0: 0,
			y0: 0,
			x1: image.width(),
			y1: image.height(),
		};
		if (ui.parent() == null) {
			image.fill(0);
			ui.onCreate(ui, ui);
			ui.onMeasure(ui, &rect);
		}

		if (action == Window.KEY_PRESS) {
			uint8 bytes[*] = pointer(keyText);
			int n = Utf8Writer.encode(&bytes, x);
			bytes[n] = 0;
		} else {
			keyText[0] = 0;
		}
		btnKey.focus();
		actionText.append(0, actionName);
		sldAction.value = action;
		sldButton.value = button;
		sldX.value = x;
		sldY.value = y;
		ui.onDraw(image, rect, 0);
	}

	return 20000;	// 20 sec timeout
}
