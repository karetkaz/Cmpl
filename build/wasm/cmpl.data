static int32 mul_30u(int32 x, uint32 y) {
	int64 result = int64(x) * y;
	result += result & (1 << 29);
	if ((result >> 63) != (result >> 61 - precision)) {
		return nan;
	}
	return result >> 30 - precision;
}
static Fixed32 mul_30u(Fixed32 x, uint32 y) {
