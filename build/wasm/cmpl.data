		// evaluate 6*(p(t)-f0) via Horner: t*(6*f1 + (t-1)*(3*a + (t-2)*delta3))
		int32 f0 = tbl_log2[idx];
		int32 f1 = (tbl_log2[idx + 1] - f0);
		int32 f2 = (tbl_log2[idx + 2] - f0);
		int32 f3 = (tbl_log2[idx + 3] - f0);
		int32 a = f2 - (f1 << 1);          // Δ²f0
