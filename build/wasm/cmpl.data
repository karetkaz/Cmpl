	}
	int64 result = int64(x.bits) * y;
	result += result & (1 << 29);
	static if (struct(Fixed32.overflow) == function) {
		if ((result >> 63) != (result >> 31 + 30)) {
			return Fixed32.overflow(result, "mul.30.result", x, y);
		}
	}
	return { bits: result >> 30 };
}

