		int32 f0 = tbl_log2[idx];
		int32 f1 = (tbl_log2[idx + 1] - f0) * 2;
		int32 f2 = tbl_log2[idx + 2] - f0;
		int32 a = f2 - f1;
		int32 b = f1 - a;

		// difference between argument and next smaller sampling point
		int32 dx = f & (1 << p) - 1;
		// find function value offset for argument x by computing ((a*dx+b)*dx)
		int64 r = a;
		r = ((r * dx + (1 << p - 1)) >> p) + b;
		r = (r * dx + (1 << p)) >> p + 1;
