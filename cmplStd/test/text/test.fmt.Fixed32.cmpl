#!/usr/bin/env -S cmpl -X+steps -run

// test fixed point number formatting
NumberFormat format = {
//	digitSymbols: NumberFormat.digits[...2],
//	positiveSymbol: '+'; // force sign,
//	fractionSymbol: ',',
//	groupingSymbol: ' ',
//	groupingDigits: 8,

//	width: 0,
	precision: 32,
	trailingZeros: true,
//	trailingSeparator: true,
};

char expect[512] = {...?};
char buff[expect.length] = {...?};

//* testing the number formatter
for (int i = 0; i < 1024; i += 1) {
	Fixed32 value = Fixed32(Float64.log2(i));
	format.format(&expect, 0, float64(value));
	format.format(&buff, 0, value);
	if (strcmp(expect, buff) != 0) {
		NotEquals.debug("not equals", NotEquals(expect, buff, null));
	}
}

format.format(&buff, 0, Fixed32(1024.1415));
debug(buff);

Fixed32(0).div(Fixed32(0)).format(&buff, "nan: %d = 0x%x");
debug(buff);

Fixed32(1).div(Fixed32(0)).format(&buff, "inf: %d = 0x%x");
debug(buff);
Fixed32(-1).div(Fixed32(0)).format(&buff, "inf: %d = 0x%x");
debug(buff);

Fixed32.bits(Fixed32.nan - 1).format(&buff, "val: %d = 0x%x");
debug(buff);
Fixed32.bits(Fixed32.nan + 1).format(&buff, "val: %d = 0x%x");
debug(buff);

Fixed32.bits(Fixed32.nan - 2).format(&buff, "val: %d = 0x%x");
debug(buff);
Fixed32.bits(Fixed32.nan + 2).format(&buff, "val: %d = 0x%x");
debug(buff);

// round-half-to-even on exact ties (value = k / 2^n, exactly representable in
// Fixed32's 20 fractional bits). The Fixed32 formatter carries its own copy of
// the rounding/carry logic; these guard it against the printf reference for the
// exact value.
static char tieExpect[64] = {...?};
static char tieBuff[64] = {...?};
void checkTie(int32 p, float64 value) {
	Fixed32 fx = Fixed32(value);
	float64.print(tieExpect, float64(fx), 0, 0, p);
	NumberFormat tie = { precision: p, trailingZeros: true };
	tie.format(&tieBuff, 0, fx);
	if (strcmp(tieExpect, tieBuff) != 0) {
		error("fixed32 tie rounding mismatch", value, tieExpect, tieBuff);
	}
}
checkTie(1, 0.25); checkTie(1, 0.75);     // -> 0.2, 0.8
checkTie(1, 1.25); checkTie(1, 1.75);     // -> 1.2, 1.8
checkTie(1, 2.25); checkTie(1, 2.75);     // -> 2.2, 2.8
checkTie(2, 0.125); checkTie(2, 0.375);   // -> 0.12, 0.38
checkTie(2, 0.625); checkTie(2, 0.875);   // -> 0.62, 0.88

// precision 0 ties: round to even, including carry into a new digit (9.5->10)
char p0Expect[16] = {...?};
char p0Buff[16] = {...?};
NumberFormat tie0 = { precision: 0, trailingZeros: true };
float64 halves[] = { 0.5, 1.5, 2.5, 3.5, 4.5, 5.5, 9.5, 99.5, 999.5 };
for (int i = 0; i < halves.length; i += 1) {
	float64 dv = halves[i];
	Fixed32 v = Fixed32(dv);
	float64.print(p0Expect, float64(v), 0, 0, 0);
	tie0.format(&p0Buff, 0, v);
	if (strcmp(p0Expect, p0Buff) != 0) {
		error("fixed32 precision-0 tie not rounded to even", dv, p0Expect, p0Buff);
	}
}

// precision >= 1 carry: fraction rounds up through all digits, creating a new
// integer digit. fractionPos must shift +1 so the trailing-trim loop stops at
// the right boundary (fractionPos bug: without the +1, "10.0" trims to "1").
static char carryExpect[32] = {...?};
static char carryBuff[32] = {...?};
void checkCarry(int32 p, float64 value) {
	Fixed32 fx = Fixed32(value);
	float64.print(carryExpect, float64(fx), 0, 0, p);
	NumberFormat fmt = { precision: p, trailingZeros: true };
	fmt.format(&carryBuff, 0, fx);
	if (strcmp(carryExpect, carryBuff) != 0) {
		error("fixed32 carry fractionPos mismatch", value, carryExpect, carryBuff);
	}
}
checkCarry(1, 9.99);   // 9.9x -> 10.0: carry creates a new integer digit
checkCarry(1, 99.99);  // 99.9x -> 100.0
checkCarry(2, 9.999);  // 9.99x -> 10.00

// trailingZeros=false: separator + trailing zeros must be stripped after carry
NumberFormat noTrail = { precision: 1 };
noTrail.format(&carryBuff, 0, Fixed32(9.99));
assert(strcmp(carryBuff, "10") == 0, "carry+noTrail: expected '10'", carryBuff);
noTrail.format(&carryBuff, 0, Fixed32(99.99));
assert(strcmp(carryBuff, "100") == 0, "carry+noTrail: expected '100'", carryBuff);
