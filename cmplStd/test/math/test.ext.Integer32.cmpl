#!/usr/bin/env -S ${CMPL_HOME}/extras/CmplDiffTest.sh -asm/a/s/0 -run 28866

void testUint32() {
	inline Signed = Int32;
	inline Unsigned = Uint32;
	inline Signed(int32 x) = Int32(x);
	inline Unsigned(int32 x) = Uint32(x);
	inline "./test.ext.Integer.impl";
}

testUint32();

