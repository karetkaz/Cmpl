struct Uint64HL {
	inline Word = Uint32;
	inline Unsigned = Uint64HL;
	inline Word(uint64 x) = Uint32(x);
	inline "cmplStd/lib/math/number/IntHL.cmpl";
}
struct Int64HL {
	inline Word = Int32;
	inline Signed = Int64HL;
	inline Unsigned = Uint64HL;
	inline Word(int64 x) = Int32(x);
	inline "cmplStd/lib/math/number/IntHL.cmpl";
}
Uint64HL Uint64HL(uint64 x) { return inline(x); }
Int64HL Int64HL(int64 x) { return inline(x); }

struct Uint128 {
	inline Word = Uint64HL;
	inline Unsigned = Uint128;
	inline Word(uint64 x) = Uint64HL(x);
	inline "cmplStd/lib/math/number/IntHL.cmpl";
}
struct Int128 {
	inline Word = Int64HL;
	inline Signed = Int128;
	inline Unsigned = Uint128;
	inline Word(int64 x) = Int64HL(x);
	inline "cmplStd/lib/math/number/IntHL.cmpl";
}
Uint128 Uint128(uint64 x) { return { hi: Uint64HL(0), lo: Uint64HL(x) }; }
Int128 Int128(int64 x) { return { hi: Int64HL(x >> 63), lo: Int64HL(x).Unsigned() }; }
} else {
