void testUintHL16() {
	struct Unsigned: 2 {
		inline Word = Uint8;
		inline Word(uint8 x) = Uint8(x);
		inline "cmplStd/lib/math/number/IntHL.cmpl";
	}
	struct Signed: 2 {
		inline Word = Int8;
		inline Unsigned = Unsigned;
		inline Word(int8 x) = Int8(x);
		inline "cmplStd/lib/math/number/IntHL.cmpl";
	}

	Unsigned Unsigned(uint16 x) { return inline(x); }
	Signed Signed(int16 x) { return inline(x); }

//	static int64 inc = 0x3f;
	inline "./test.ext.Integer.impl";
}
