#!/usr/bin/env -S ${CMPL_HOME}/extras/CmplDiffTest.sh

static if (struct(x) != null && struct(y) != null) {
	assert(x + y, x, y);
	assert(x - y, x, y);
	assert(x * y, x, y);
	assert(x / y, x, y);
	assert(x % y, x, y);
	assert(x == y, x, y);
	assert(x != y, x, y);
	assert(x < y, x, y);
	assert(x <= y, x, y);
	assert(x > y, x, y);
	assert(x >= y, x, y);

	static if (struct(x) != float32 && struct(x) != float64 && struct(y) != float32 && struct(y) != float64) {
		assert(x & y, x, y);
		assert(x | y, x, y);
		assert(x ^ y, x, y);
		// assert(x << y, x, y);
		// assert(x >> y, x, y);
	}
}
static if (struct(x) != null && struct(y) == null) {
	if (true) { int8 y = int8(_y); inline "./test.operator.cmpl"; }
	if (true) { int16 y = int16(_y); inline "./test.operator.cmpl"; }
	if (true) { int32 y = int32(_y); inline "./test.operator.cmpl"; }
	if (true) { int64 y = int64(_y); inline "./test.operator.cmpl"; }
	if (true) { uint8 y = uint8(_y); inline "./test.operator.cmpl"; }
	if (true) { uint16 y = uint16(_y); inline "./test.operator.cmpl"; }
	if (true) { uint32 y = uint32(_y); inline "./test.operator.cmpl"; }
	if (true) { uint64 y = uint64(_y); inline "./test.operator.cmpl"; }
	if (true) { float32 y = float32(_y); inline "./test.operator.cmpl"; }
	if (true) { float64 y = float64(_y); inline "./test.operator.cmpl"; }
}
static if (struct(x) == null && struct(y) == null) {
typename typeOf(variant var) {
	struct Variant {
		pointer data;
		typename type;
	}
	Variant v = inline(var);
	return v.type;
}

void assert(variant lhs, variant rhs, variant result, typename promoted) {
	if (promoted == typeOf(result)) {
		raise(raise.debug, raise.noTrace, "assertion passed", lhs, rhs, result);
		return;
	}
	raise(raise.error, raise.noTrace, "assertion failed", lhs, rhs, result, promoted);
}

void test(int _x, int _y) {
	static typename promote(variant a, variant b) {
		static typename promote(typename a) {
			if (a == int8 || a == int16) {
				// smaller types convert to 32 bit integer
				return int32;
			}
			if (a == uint8 || a == uint16) {
				// unsigned small types fit into 32 bit integer
				return int32;
			}
			if (a == int32 || a == int64) {
				return a;
			}
			if (a == uint32 || a == uint64) {
				return a;
			}
			if (a == float32 || a == float64) {
				return a;
			}

			// unknown type
			return null;
		}
		static typename promote(typename _a, typename _b) {
			typename a = promote(_a);
			typename b = promote(_b);
			if (a == float64 || b == float64) {
				return float64;
			}
			if (a == float32 || b == float32) {
				return float32;
			}
			if (a == uint64 || b == uint64) {
				return uint64;
			}
			if (a == int64 || b == int64) {
				return int64;
			}
			if (a == uint32 || b == uint32) {
				return uint32;
			}
			if (a == int32 || b == int32) {
				return int32;
			}

			// unknown type
			return null;
		}

		return promote(typeOf(a), typeOf(b));
	}
	void assert(bool result!, variant lhs, variant rhs) { assert(lhs, rhs, result, bool); }
	void assert(int32 result!, variant lhs, variant rhs) { assert(lhs, rhs, result, promote(lhs, rhs)); }
	void assert(int64 result!, variant lhs, variant rhs) { assert(lhs, rhs, result, promote(lhs, rhs)); }
	void assert(uint32 result!, variant lhs, variant rhs) { assert(lhs, rhs, result, promote(lhs, rhs)); }
	void assert(uint64 result!, variant lhs, variant rhs) { assert(lhs, rhs, result, promote(lhs, rhs)); }
	void assert(float32 result!, variant lhs, variant rhs) { assert(lhs, rhs, result, promote(lhs, rhs)); }
	void assert(float64 result!, variant lhs, variant rhs) { assert(lhs, rhs, result, promote(lhs, rhs)); }

	inline "cmplStd/lib/lang/Operator.cmpl";
	if (true) { int8 x = int8(_x); inline "./test.operator.cmpl"; }
	if (true) { int16 x = int16(_x); inline "./test.operator.cmpl"; }
	if (true) { int32 x = int32(_x); inline "./test.operator.cmpl"; }
	if (true) { int64 x = int64(_x); inline "./test.operator.cmpl"; }
	if (true) { uint8 x = uint8(_x); inline "./test.operator.cmpl"; }
	if (true) { uint16 x = uint16(_x); inline "./test.operator.cmpl"; }
	if (true) { uint32 x = uint32(_x); inline "./test.operator.cmpl"; }
	if (true) { uint64 x = uint64(_x); inline "./test.operator.cmpl"; }
	if (true) { float32 x = float32(_x); inline "./test.operator.cmpl"; }
	if (true) { float64 x = float64(_x); inline "./test.operator.cmpl"; }
}

test(5, 2);
test(35000, 177);
test(177, 35000);
}

