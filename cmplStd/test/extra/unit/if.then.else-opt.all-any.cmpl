#!/usr/bin/env -S ${CMPL_HOME}/extras/CmplDiffTest.sh

void test(int a, int b, int c) {
	void debug(char message[*]) {
		static if (struct(raise) == function) {
			raise(raise.info, raise.noTrace, message);
		}
	}

	if (a == 42 && b == 42 && c == 42) {
		debug("All Pass");
	}
	if (a == 42 || b == 42 || c == 42) {
		debug("Any Pass");
	}
}

test(42, 42, 42);

