#!/usr/bin/env -S ${CMPL_HOME}/extras/CmplDiffTest.sh

// plain recursive calls, no native call bridging
int levelN(int b) {
	if (b > 0) { return levelN(b - 1); }
	trace("bottom of recursion", b);
	return b;
}
levelN(3);

// single invoke() bridge: the callback has no call-site of its own, the
// native call that bridged over it (recover) shows the real call-site
void bridgedInner(pointer data) {
	trace("inside callback invoked via recover");
}
void bridgedCb(pointer data) {
	bridgedInner(data);
}
void callsBridged(pointer data) {
	recover(data, bridgedCb);
}
callsBridged(null);

// two bridges crossed, with a real (non-bridged) call in between
void innerCb(pointer data) {
	trace("nested callback, two bridges up");
}
void midFn(pointer data) {
	recover(data, innerCb);
}
void outerCb(pointer data) {
	midFn(data);
}
void callsOuterTry(pointer data) {
	recover(data, outerCb);
}
callsOuterTry(null);

// back-to-back bridges, no real call between them: the invoke() call is
// the caller's own last (only) statement
void deepCb(pointer data) {
	trace("nested invoke, no real frame in between");
}
void midCb(pointer data) {
	recover(data, deepCb);
}
void outerCall(pointer data) {
	recover(data, midCb);
}
outerCall(null);

// maxCalls/skipCalls bound the number of printed frames, bridge frames
// count against the same budget as real frames
void truncCb(pointer data) {
	raise(raise.error, 4, "truncated trace across a bridge");
}
void truncWrap(pointer data) {
	recover(data, truncCb);
}
void truncCaller(pointer data) {
	truncWrap(data);
}
truncCaller(null);

// recursive calls, plain and native call bridging
static void recoverRecursive(int b, int mod);
static void tryFnRecursive(pointer data) {
	int args[*] = pointer(data);
	recoverRecursive(args[0], args[1]);
}
static void recoverRecursive(int32 b, int32 mod) {
	if (b == 0) {
		trace("bottom of recursion", b);
		return;
	}
	int args[2] = {b - Int32.sign(b), mod};
	if ((b % mod != 0) != (b < 0)) {
		recoverRecursive(args[0], mod);
		return;
	}
	recover(pointer(args), tryFnRecursive);
}
recoverRecursive(7, 5);
recoverRecursive(-7, 5);

