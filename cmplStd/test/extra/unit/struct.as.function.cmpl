#!/usr/bin/env -S ${CMPL_HOME}/extras/CmplDiffTest.sh 73

int32 test(uint8 x) {
	typename v = struct();
	struct(x) y = 3;
	uint32 z = 80;

	assert(v == void);
	assert(struct() == void);
	assert(struct(0) == int32);
	assert(struct(0.) == float64);
	assert(struct(x) == uint8);
	assert(struct(+x) == int32);
	assert(struct(+y) == int32);
	assert(struct(+z) == uint32);
	assert(struct(x + y) == int32);
	assert(struct(x + z) == uint32);
	return x * y;
}

int32 t = test(9);

