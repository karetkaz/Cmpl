// align 0 => union
struct record_pack0: 0 {
	uint8 _0;
	uint64 a;
	uint8 _1;
	uint32 b;
	uint8 _2;
	uint16 c;
}

// align 1 => no padding
struct record_pack1: 1 {
	uint8 _0;
	uint64 a;
	uint8 _1;
	uint32 b;
	uint8 _2;
	uint16 c;
}

// align 2 => padding is max 2
struct record_pack2: 2 {
	uint8 _0;
	uint64 a;
	uint8 _1;
	uint32 b;
	uint8 _2;
	uint16 c;
}

// align 4 => padding is max 4
struct record_pack4: 4 {
	uint8 _0;
	uint64 a;
	uint8 _1;
	uint32 b;
	uint8 _2;
	uint16 c;
}

// align 8 => padding is max 8
struct record_pack8: 8 {
	uint8 _0;
	uint64 a;
	uint8 _1;
	uint32 b;
	uint8 _2;
	uint16 c;
}

// no alignment => padding is set by the compiler
struct record_packDef {
	uint8 _0;
	uint64 a;
	uint8 _1;
	uint32 b;
	uint8 _2;
	uint16 c;
}

// default packing is the memory alignment of the host platform: 4 or 8 bytes
inline memAlign = System.Platform.pointerSize;
assert(memAlign == 4 || memAlign == 8);

// the sizes are the same as in C, using `#pragma pack(n)`
assert(sizeof(record_pack0) == 8);
assert(sizeof(record_pack1) == 17);
assert(sizeof(record_pack2) == 20);
assert(sizeof(record_pack4) == 24);
assert(sizeof(record_pack8) == 32);
assert(sizeof(record_packDef) == (memAlign == 4 ? sizeof(record_pack4) : sizeof(record_pack8)));

// like in C, the size is padded only to the largest alignment of the members
struct record_int8 { int8 a; }
struct record_int32 { int32 a; }
struct record_int32x3 { int32 a; int32 b; int32 c; }
struct record_int64int8 { int64 a; int8 b; }
assert(sizeof(record_int8) == 1);
assert(sizeof(record_int32) == 4);
assert(sizeof(record_int32x3) == 12);
assert(sizeof(record_int64int8) == 8 + memAlign);

// nested records are aligned to the largest alignment of their members
struct record_nested { int8 a; record_int32x3 b; }
assert(sizeof(record_nested) == 16);

// nested packed records are not padded
struct record_packed1 { int8 a; record_pack1 b; }
assert(sizeof(record_packed1) == 18);

// union: padded to the largest alignment of the members
struct record_union: 0 { int8 a[3]; int16 b; }
assert(sizeof(record_union) == 4);
