/// Computer / named timezone helpers.
struct Timezone {
	/// Zone abbreviation or id: "UTC", "EET", "America/New_York", ...
	char name![];

	/// Offset east of UTC at `timestamp`; sets `isDaylightSaving` when DST applies.
	Duration offset(Timezone zone!, Timestamp timestamp, bool isDaylightSaving&);

	/// Offset east of UTC at `timestamp` (ignores DST flag).
	static Duration offset(Timezone zone!, Timestamp timestamp) {
		bool isDaylightSaving;
		return zone.offset(zone, timestamp, &isDaylightSaving);
	}

	/// UTC timezone (offset always zero)
	static Timezone utc() {
		static Duration offset(Timezone zone!, Timestamp timestamp, bool isDaylightSaving&) {
			isDaylightSaving = false;
			return { value: 0 };
		}
		return {
			offset: offset,
			name: "UTC",
		};
	}

	/// Host computer local timezone (offset follows system DST rules)
	static Timezone local() {
		// Name queried once on first local() call; offset stays per-timestamp.
		static char localName[64] = {};
		static int32 nameLen = -1;
		if (nameLen < 0) {
			System.localZoneName(localName);
			nameLen = 0;
			for (; nameLen < localName.length && localName[nameLen] != 0; nameLen += 1) {}
		}

		static Duration offset(Timezone zone!, Timestamp timestamp, bool isDaylightSaving&) {
			return Duration.millis(System.localZoneOffset(timestamp.value(Timeunit.Millis), &isDaylightSaving));
		}
		return {
			offset: offset,
			name: localName[...nameLen],
		};
	}

	/// Lookup timezone by IANA / Windows name (not implemented yet)
	static Timezone lookup(char name[]) {
		abort("todo");
		return {
			offset: null,
			name: name,
		};
	}
}
