/// 32-bit unsigned integer
struct Uint32: 4 {
	uint32 value;

	enum {
		bits: 32,
		min: 0x00000000U,
		max: 0xffffffffU,
	}

	inline u32(Uint32 x) = uint32(x.value);
	inline u64(Uint32 x) = uint64(u32(x));

	/// Test if the value is zero or not, also the signum of the input (`0` if zero, `1` if positive)
	static int32 test(Uint32 x) { return int32(u32(x) > 0); }

	/// Negates a 32-bit unsigned value
	static Uint32 neg(Uint32 x) { return { value: inline(u32(x), i32.neg) }; }

	/// Adds two 32-bit unsigned integers
	static Uint32 add(Uint32 x, Uint32 y) { return { value: inline(u32(x), u32(y), i32.add) }; }

	/// Subtracts two 32-bit unsigned integers
	static Uint32 sub(Uint32 x, Uint32 y) { return { value: inline(u32(x), u32(y), i32.sub) }; }

	/// Multiplies two 32-bit unsigned integers
	static Uint32 mul(Uint32 x, Uint32 y) { return { value: inline(u32(x), u32(y), u32.mul) }; }

	/// Divides two 32-bit unsigned integers
	static Uint32 div(Uint32 x, Uint32 y) { return { value: inline(u32(x), u32(y), u32.div) }; }

	/// Divide x by y, returning remainder
	static Uint32 rem(Uint32 x, Uint32 y) { return { value: inline(u32(x), u32(y), u32.rem) }; }

	/// Negates a 32-bit unsigned value
	static Uint32 neg(Uint32 x, Uint32 overflow&) {
		overflow.value = 1; // always overflows
		return { value: inline(u32(x), i32.neg) };
	}

	/// Adds two 32-bit unsigned integers with carry out
	static Uint32 add(Uint32 x, Uint32 y, Uint32 overflow&) {
		uint64 result = inline(u64(x), u64(y), i64.add);
		overflow.value = result >> bits;
		return { value: result };
	}

	/// Adds two 32-bit unsigned integers with carry in and out
	static Uint32 add(Uint32 x, Uint32 y, Uint32 c, Uint32 overflow&) {
		int64 result = inline(u64(x), u64(y), i64.add, u64(c), i64.add);
		overflow.value = result >> bits;
		return { value: result };
	}

	/// Subtracts two 32-bit unsigned integers with borrow out
	static Uint32 sub(Uint32 x, Uint32 y, Uint32 overflow&) {
		uint64 result = inline(u64(x), u64(y), i64.sub);
		overflow.value = -(result >> bits);
		return { value: result };
	}

	/// Subtracts two 32-bit unsigned integers with borrow in and out
	static Uint32 sub(Uint32 x, Uint32 y, Uint32 c, Uint32 overflow&) {
		uint64 result = inline(u64(x), u64(y), i64.sub, u64(c), i64.sub);
		overflow.value = -(result >> bits);
		return { value: result };
	}

	/// Multiplies two 32-bit unsigned integers with overflow out
	static Uint32 mul(Uint32 x, Uint32 y, Uint32 overflow&) {
		uint64 result = inline(u64(x), u64(y), u64.mul);
		overflow.value = result >> bits;
		return { value: result };
	}

	/// Computes the bitwise NOT of a 32-bit unsigned value
	static Uint32 cmt(Uint32 x) { return { value: inline(u32(x), u32.cmt) }; }

	/// Computes the bitwise OR of two 32-bit unsigned integers
	static Uint32 or(Uint32 x, Uint32 y) { return { value: inline(u32(x), u32(y), u32.or) }; }

	/// Computes the bitwise XOR of two 32-bit unsigned integers
	static Uint32 xor(Uint32 x, Uint32 y) { return { value: inline(u32(x), u32(y), u32.xor) }; }

	/// Computes the bitwise AND of two 32-bit unsigned integers
	static Uint32 and(Uint32 x, Uint32 y) { return { value: inline(u32(x), u32(y), u32.and) }; }

	/// Performs a logical left shift of x by n bits for a 32-bit unsigned integer
	static Uint32 shl(Uint32 x, uint32 n) { return { value: inline(u32(x), uint32(n), u32.shl) }; }

	/// Performs a logical right shift of x by n bits for a 32-bit unsigned integer
	static Uint32 shr(Uint32 x, uint32 n) { return { value: inline(u32(x), uint32(n), u32.shr) }; }

	/// Performs an arithmetic right shift of x by n bits for a 32-bit unsigned integer
	static Uint32 sar(Uint32 x, uint32 n) { return { value: inline(u32(x), uint32(n), u32.sar) }; }

	/// Returns the value of x rotated left by (n mod size) bits
	static Uint32 rotateLeft(Uint32 x, uint32 n) {
		return x.shl(n & (bits - 1)).or(x.shr(bits - n & (bits - 1)));
	}

	/// Returns the value of x rotated right by (n mod size) bits
	static Uint32 rotateRight(Uint32 x, uint32 n) {
		return x.shr(n & (bits - 1)).or(x.shl(bits - n & (bits - 1)));
	}

	static Uint32 lowestBit(Uint32 x) { return x.and(neg(x)); }

	/// Returns the minimum number of bits required to represent the value of `x`
	static int32 length(Uint32 x) {
		static if (System.Platform.preferNativeCalls && struct(uint32.len) != null) {
			// use the native method if available
			return uint32.len(u32(x));
		}

		uint32 bits = u32(x);
		int32 result = 0;

		if ((bits >> 16) != 0) {
			result += 16;
			bits >>= 16;
		}
		if ((bits >> 8) != 0) {
			result += 8;
			bits >>= 8;
		}
		if ((bits >> 4) != 0) {
			result += 4;
			bits >>= 4;
		}
		if ((bits >> 2) != 0) {
			result += 2;
			bits >>= 2;
		}
		if ((bits >> 1) != 0) {
			result += 1;
			bits >>= 1;
		}
		return result + bits;
	}

	/// Returns the number of leading zero bits in x
	static int32 leadingZeros(Uint32 x) { return bits - length(x); }

	/// Returns the number of trailing zero bits in x
	static int32 trailingZeros(Uint32 x) {
		if (x.value == 0) {
			return bits;
		}

		return x.lowestBit().length() - 1;
	}

	/// Finds the index of the most significant(highest) set bit.
	static int32 scanReverse(Uint32 x) { return x.length() - 1; }

	/// Finds the index of the least significant(lowest) set bit
	// or return x == 0 ? -1 : trailingZeros(x);
	static int32 scanForward(Uint32 x) { return x.lowestBit().length() - 1; }

	/// Returns the number of set bits ("population count") in x
	static int32 countOnes(Uint32 y) {
		static if (System.Platform.preferNativeCalls && struct(uint32.pop) != null) {
			// use the native method if available
			return uint32.pop(u32(y));
		}

		uint32 x = u32(y);
		x -= (x >> 1) & 0x55555555;
		x = (x & 0x33333333) + ((x >> 2) & 0x33333333);
		x = (x + (x >> 4)) & 0x0f0f0f0f;
		x += x >> 8;
		x += x >> 16;
		return x & 0x3f;
	}

	/// Returns the value of x with its bits in reversed order
	static Uint32 reverseBits(Uint32 y) {
		uint32 x = u32(y);
		x = ((x >> 1) & 0x55555555) | ((x & 0x55555555) << 1);
		x = ((x >> 2) & 0x33333333) | ((x & 0x33333333) << 2);
		x = ((x >> 4) & 0x0f0f0f0f) | ((x & 0x0f0f0f0f) << 4);
		x = ((x >> 8) & 0x00ff00ff) | ((x & 0x00ff00ff) << 8);
		return { value: (x >> 16) | (x << 16) };
	}

	/// Reverses the byte order of a 32-bit unsigned integer
	static Uint32 reverseBytes(Uint32 y) {
		uint32 x = u32(y);
		x = (x & 0x0000ffff) << 16 | (x & 0xffff0000) >> 16;
		x = (x & 0x00ff00ff) << 8  | (x & 0xff00ff00) >> 8;
		return { value: x };
	}

	/// Returns the absolute value (identity for unsigned)
	static Uint32 abs(Uint32 x) { return x; }

	/// Returns the smaller of two values
	static Uint32 min(Uint32 a, Uint32 b) { return u32(a) < u32(b) ? a : b; }

	/// Returns the greater of two values
	static Uint32 max(Uint32 a, Uint32 b) { return u32(a) > u32(b) ? a : b; }

	/// Returns the `value` clamped between the provided `lo` and `hi`
	static Uint32 clamp(Uint32 value, Uint32 lo, Uint32 hi) { return min(max(value, lo), hi); }

	/// Compare: returns 0 if equal, positive if x > y, negative if x < y
	static int32 compare(Uint32 x, Uint32 y) {
		return int32(u32(x) > u32(y)) - int32(u32(x) < u32(y));
	}

	/// todo: deprecated method, use the called one
	inline countOnes(uint32 x) = countOnes(Uint32(inline(x)));
	/// todo: deprecated method, use the called one
	inline reverseBits(uint32 x) = uint32(inline(reverseBits(Uint32(inline(x)))));
	/// todo: deprecated method, use the called one
	inline scanForward(uint32 x) = scanForward(Uint32(inline(x)));
	/// todo: deprecated method, use the called one
	inline scanReverse(uint32 x) = scanReverse(Uint32(inline(x)));
	/// todo: deprecated method, use the called one
	inline sign(uint32 x) = test(Uint32(inline(x)));
	/// todo: deprecated method, use the called one
	inline abs(uint32 x) = uint32(inline(abs(Uint32(inline(x)))));
	/// todo: deprecated method, use the called one
	inline min(uint32 x, uint32 y) = uint32(inline(min(Uint32(inline(x)), Uint32(inline(y)))));
	/// todo: deprecated method, use the called one
	inline max(uint32 x, uint32 y) = uint32(inline(max(Uint32(inline(x)), Uint32(inline(y)))));
	/// todo: deprecated method, use the called one
	inline clamp(uint32 value, uint32 lo, uint32 hi) = uint32(inline(clamp(Uint32(inline(value)), Uint32(inline(lo)), Uint32(inline(hi)))));
	/// todo: deprecated method, use the called one
	inline compare(uint32 x, uint32 y) = compare(Uint32(inline(x)), Uint32(inline(y)));

	/// Extracts and zero-extends a bit field from a value
	static uint32 zeroExtend(uint32 value, int32 offs, int32 size) {
		return value << (bits - (offs + size)) >> (bits - size);
	}
}

/// 32-bit signed integer
struct Int32: 4 {
	int32 value;

	enum {
		bits: Uint32.bits,
		max: 1 << bits - 1,
		min: ~max,
	}

	inline i32(Int32 x) = int32(x.value);
	inline i64(Int32 x) = int64(i32(x));

	/// Computes the arithmetic negation of a 32-bit signed integer
	static Int32 neg(Int32 x) { return { value: inline(i32(x), i32.neg) }; }

	/// Add two values
	static Int32 add(Int32 x, Int32 y) { return { value: inline(i32(x), i32(y), i32.add) }; }

	/// Subtract two values
	static Int32 sub(Int32 x, Int32 y) { return { value: inline(i32(x), i32(y), i32.sub) }; }

	/// Multiply two values
	static Int32 mul(Int32 x, Int32 y) { return { value: inline(i32(x), i32(y), i32.mul) }; }

	/// Divide x by y, returning quotient
	static Int32 div(Int32 x, Int32 y) { return { value: inline(i32(x), i32(y), i32.div) }; }

	/// Divide x by y, returning remainder
	static Int32 rem(Int32 x, Int32 y) { return { value: inline(i32(x), i32(y), i32.rem) }; }

	/// Computes the arithmetic negation of a 32-bit signed integer
	static Int32 neg(Int32 x, Int32 overflow&) {
		overflow.value = int32(i32(x) == min);
		return { value: inline(i32(x), i32.neg) };
	}

	/// Adds two 32-bit signed integers with carry out
	static Int32 add(Int32 x, Int32 y, Int32 overflow&) {
		int64 result = inline(i64(x), i64(y), i64.add);
		overflow.value = int32(result > max || result < min);
		return { value: result };
	}

	/// Subtracts two 32-bit signed integers with borrow out
	static Int32 sub(Int32 x, Int32 y, Int32 overflow&) {
		int64 result = inline(i64(x), i64(y), i64.sub);
		overflow.value = int32(result > max || result < min);
		return { value: result };
	}

	/// Multiplies two 32-bit signed integers with overflow out
	static Int32 mul(Int32 x, Int32 y, Int32 overflow&) {
		int64 result = inline(i64(x), i64(y), i64.mul);
		overflow.value = result >> bits;
		return { value: result };
	}

	/// Returns the sign of the value: `-1` if negative, `0` if zero, `1` if positive
	static int32 sign(Int32 x) {
		return int32(i32(x) > 0) - int32(i32(x) < 0);
	}

	/// Returns the absolute value
	static Int32 abs(Int32 x) { return i32(x) < 0 ? x.neg() : x; }

	/// Returns the smaller of two values
	static Int32 min(Int32 a, Int32 b) { return i32(a) < i32(b) ? a : b; }

	/// Returns the greater of two values
	static Int32 max(Int32 a, Int32 b) { return i32(a) > i32(b) ? a : b; }

	/// Returns the `value` clamped between the provided `lo` and `hi`
	static Int32 clamp(Int32 value, Int32 lo, Int32 hi) { return min(max(value, lo), hi); }

	/// Compare: returns 0 if equal, positive if x > y, negative if x < y
	static int32 compare(Int32 x, Int32 y) {
		return int32(i32(x) > i32(y)) - int32(i32(x) < i32(y));
	}

	/// todo: deprecated method, use the called one
	inline sign(int32 x) = sign(Int32(inline(x)));
	/// todo: deprecated method, use the called one
	inline abs(int32 x) = int32(inline(abs(Int32(inline(x)))));
	/// todo: deprecated method, use the called one
	inline min(int32 x, int32 y) = int32(inline(min(Int32(inline(x)), Int32(inline(y)))));
	/// todo: deprecated method, use the called one
	inline max(int32 x, int32 y) = int32(inline(max(Int32(inline(x)), Int32(inline(y)))));
	/// todo: deprecated method, use the called one
	inline clamp(int32 value, int32 lo, int32 hi) = int32(inline(clamp(Int32(inline(value)), Int32(inline(lo)), Int32(inline(hi)))));
	/// todo: deprecated method, use the called one
	inline compare(int32 x, int32 y) = compare(Int32(inline(x)), Int32(inline(y)));

	/// Extracts and sign-extends a bit field from a value
	static int32 signExtend(int32 value, int32 offs, int32 size) {
		return value << (bits - (offs + size)) >> (bits - size);
	}
}

/// Construct a Uint32 from a 32-bit unsigned value
Uint32 Uint32(uint32 value) { return { value: value }; }

/// Convert a Uint32 value to a uint32
uint32 uint32(Uint32 value) { return value.value; }

/// Construct an Int32 from a 32-bit signed value
Int32 Int32(int32 value) { return { value: value }; }

/// Convert an Int32 value to an int32
int32 int32(Int32 value) { return value.value; }
