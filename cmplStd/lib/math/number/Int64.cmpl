/// 64-bit unsigned integer
struct Uint64: 8 {
	uint64 value;

	enum {
		bits: 64,
		min: 0x0000000000000000,
		max: 0xffffffffffffffff,
	}

	inline u64(Uint64 x) = x.value;

	/// Test if the value is zero or not, also the signum of the input (`0` if zero, `1` if positive)
	static int32 test(Uint64 x) { return uint32(u64(x) > 0); }

	/// Negates a 64-bit unsigned value
	static Uint64 neg(Uint64 x) { return { value: inline(u64(x), i64.neg) }; }

	/// Adds two 64-bit unsigned integers
	static Uint64 add(Uint64 x, Uint64 y) { return { value: inline(u64(x), u64(y), i64.add) }; }

	/// Subtracts two 64-bit unsigned integers
	static Uint64 sub(Uint64 x, Uint64 y) { return { value: inline(u64(x), u64(y), i64.sub) }; }

	/// Multiplies two 64-bit unsigned integers
	static Uint64 mul(Uint64 x, Uint64 y) { return { value: inline(u64(x), u64(y), u64.mul) }; }

	/// Divides two 64-bit unsigned integers
	static Uint64 div(Uint64 x, Uint64 y) { return { value: inline(u64(x), u64(y), u64.div) }; }

	/// Divide x by y, returning remainder
	static Uint64 rem(Uint64 x, Uint64 y) { return { value: inline(u64(x), u64(y), u64.rem) }; }

	/// Negates a 64-bit unsigned value
	static Uint64 neg(Uint64 x, Uint64 overflow&) {
		overflow.value = 1; // always overflows
		return { value: inline(u64(x), i64.neg) };
	}

	/// Adds two 64-bit unsigned integers with carry out
	static Uint64 add(Uint64 x, Uint64 y, Uint64 overflow&) {
		uint64 result = inline(u64(x), u64(y), i64.add);
		overflow.value = uint64(result < x.value);
		return { value: result };
	}

	/// Adds two 64-bit unsigned integers with carry in and out
	static Uint64 add(Uint64 x, Uint64 y, Uint64 c, Uint64 overflow&) {
		uint64 sum = inline(u64(x), u64(y), i64.add);
		uint64 result = inline(uint64(sum), uint64(c.value), i64.add);
		overflow.value = uint64(sum < x.value) + uint64(result < sum);
		return { value: result };
	}

	/// Subtracts two 64-bit unsigned integers with borrow out
	static Uint64 sub(Uint64 x, Uint64 y, Uint64 overflow&) {
		uint64 result = inline(u64(x), u64(y), i64.sub);
		overflow.value = uint64(x.value < y.value);
		return { value: result };
	}

	/// Subtracts two 64-bit unsigned integers with borrow in and out
	static Uint64 sub(Uint64 x, Uint64 y, Uint64 c, Uint64 overflow&) {
		uint64 diff = inline(u64(x), u64(y), i64.sub);
		uint64 result = inline(uint64(diff), uint64(c.value), i64.sub);
		overflow.value = uint64(x.value < y.value) + uint64(diff < c.value);
		return { value: result };
	}

	/// Multiplies two 64-bit unsigned integers with overflow out
	static Uint64 mul(Uint64 x, Uint64 y, Uint64 overflow&) {
		enum { bits: Uint32.bits, mask: Uint32.max }
		uint64 xl = x.value & mask;
		uint64 xh = x.value >> bits;
		uint64 yl = y.value & mask;
		uint64 yh = y.value >> bits;

		uint64 t0 = xl * yl;
		uint64 t1 = xh * yl;
		uint64 t2 = xl * yh;
		uint64 t3 = xh * yh;

		uint64 u1 = t1 + (t0 >> bits);
		uint64 u2 = t2 + (u1 & mask);

		overflow.value = t3 + (u2 >> bits) + (u1 >> bits);
		return { value: (u2 << bits) | (t0 & mask) };
	}

	/// Computes the bitwise NOT of a 64-bit unsigned value
	static Uint64 cmt(Uint64 x) { return { value: inline(u64(x), u64.cmt) }; }

	/// Computes the bitwise OR of two 64-bit unsigned integers
	static Uint64 or(Uint64 x, Uint64 y) { return { value: inline(u64(x), u64(y), u64.or) }; }

	/// Computes the bitwise XOR of two 64-bit unsigned integers
	static Uint64 xor(Uint64 x, Uint64 y) { return { value: inline(u64(x), u64(y), u64.xor) }; }

	/// Computes the bitwise AND of two 64-bit unsigned integers
	static Uint64 and(Uint64 x, Uint64 y) { return { value: inline(u64(x), u64(y), u64.and) }; }

	/// Performs a logical left shift of x by n bits for a 64-bit unsigned integer
	static Uint64 shl(Uint64 x, uint32 n) { return { value: inline(u64(x), uint32(n), u64.shl) }; }

	/// Performs a logical right shift of x by n bits for a 64-bit unsigned integer
	static Uint64 shr(Uint64 x, uint32 n) { return { value: inline(u64(x), uint32(n), u64.shr) }; }

	/// Performs an arithmetic right shift of x by n bits for a 64-bit unsigned integer
	static Uint64 sar(Uint64 x, uint32 n) { return { value: inline(u64(x), uint32(n), u64.sar) }; }

	/// Returns the value of x rotated left by (n mod size) bits
	static Uint64 rotateLeft(Uint64 x, uint32 n) {
		return x.shl(n & (bits - 1)).or(x.shr(bits - n & (bits - 1)));
	}

	/// Returns the value of x rotated right by (n mod size) bits
	static Uint64 rotateRight(Uint64 x, uint32 n) {
		return x.shr(n & (bits - 1)).or(x.shl(bits - n & (bits - 1)));
	}

	static Uint64 lowestBit(Uint64 x) { return x.and(neg(x)); }

	/// Returns the minimum number of bits required to represent the value of `x`
	static int32 length(Uint64 x) {
		static if (System.Compiler.preferNativeCalls && struct(uint64.len) != null) {
			// use the native method if available
			return uint64.len(u64(x));
		}

		uint64 bits = u64(x);
		int32 result = 0;
		if ((bits >> 32) != 0) {
			result += 32;
			bits >>= 32;
		}
		if ((bits >> 16) != 0) {
			result += 16;
			bits >>= 16;
		}
		if ((bits >> 8) != 0) {
			result += 8;
			bits >>= 8;
		}
		if ((bits >> 4) != 0) {
			result += 4;
			bits >>= 4;
		}
		if ((bits >> 2) != 0) {
			result += 2;
			bits >>= 2;
		}
		if ((bits >> 1) != 0) {
			result += 1;
			bits >>= 1;
		}
		return result + bits;
	}

	/// Returns the number of leading zero bits in x
	static int32 leadingZeros(Uint64 x) { return bits - length(x); }

	/// Returns the number of trailing zero bits in x
	static int32 trailingZeros(Uint64 x) {
		if (x.value == 0) {
			return bits;
		}

		return x.lowestBit().length() - 1;
	}

	/// Finds the index of the most significant(highest) set bit.
	static int32 scanReverse(Uint64 x) { return x.length() - 1; }

	/// Finds the index of the least significant(lowest) set bit
	// or return x == 0 ? -1 : trailingZeros(x);
	static int32 scanForward(Uint64 x) { return x.lowestBit().length() - 1; }

	/// Returns the number of set bits ("population count") in x
	static int32 countOnes(Uint64 y) {
		static if (System.Compiler.preferNativeCalls && struct(uint64.pop) != null) {
			// use the native method if available
			return uint64.pop(u64(y));
		}

		uint64 x = u64(y);
		x -= (x >> 1) & 0x5555555555555555;
		x = (x & 0x3333333333333333) + ((x >> 2) & 0x3333333333333333);
		x = (x + (x >> 4)) & 0x0f0f0f0f0f0f0f0f;
		x += x >> 8;
		x += x >> 16;
		x += x >> 32;
		return x & 0x3f;
	}

	/// Returns the value of x with its bits in reversed order
	static Uint64 reverseBits(Uint64 y) {
		uint64 x = u64(y);
		x = ((x >>  1) & 0x5555555555555555) | ((x & 0x5555555555555555) <<  1);
		x = ((x >>  2) & 0x3333333333333333) | ((x & 0x3333333333333333) <<  2);
		x = ((x >>  4) & 0x0f0f0f0f0f0f0f0f) | ((x & 0x0f0f0f0f0f0f0f0f) <<  4);
		x = ((x >>  8) & 0x00ff00ff00ff00ff) | ((x & 0x00ff00ff00ff00ff) <<  8);
		x = ((x >> 16) & 0x0000ffff0000ffff) | ((x & 0x0000ffff0000ffff) << 16);
		return { value: (x >> 32) | (x << 32) };
	}

	/// Reverses the byte order of a 64-bit unsigned integer
	static Uint64 reverseBytes(Uint64 y) {
		uint64 x = u64(y);
		x = (x & 0x00000000ffffffff) << 32 | (x & 0xffffffff00000000) >> 32;
		x = (x & 0x0000ffff0000ffff) << 16 | (x & 0xffff0000ffff0000) >> 16;
		x = (x & 0x00ff00ff00ff00ff) << 8  | (x & 0xff00ff00ff00ff00) >> 8;
		return { value: x };
	}

	/// Returns the absolute value (identity for unsigned)
	static Uint64 abs(Uint64 x) { return x; }

	/// Returns the smaller of two values
	static Uint64 min(Uint64 a, Uint64 b) { return u64(a) < u64(b) ? a : b; }

	/// Returns the greater of two values
	static Uint64 max(Uint64 a, Uint64 b) { return u64(a) > u64(b) ? a : b; }

	/// Returns the `value` clamped between the provided `lo` and `hi`
	static Uint64 clamp(Uint64 value, Uint64 lo, Uint64 hi) { return min(max(value, lo), hi); }

	/// Compare: returns 0 if equal, positive if x > y, negative if x < y
	static int32 compare(Uint64 x, Uint64 y) {
		return int32(u64(x) > u64(y)) - int32(u64(x) < u64(y));
	}

	/// todo: deprecated method, use the called one
	inline reverseBytes(uint64 x) = uint64(inline(reverseBytes(Uint64(inline(x)))));

	/// Extracts and zero-extends a bit field from a value
	static uint64 zeroExtend(uint64 value, int32 offs, int32 size) {
		return value << (bits - (offs + size)) >> (bits - size);
	}
}

/// 64-bit signed integer
struct Int64: 8 {
	int64 value;

	enum {
		bits: Uint64.bits,
		max: 1U << bits - 1,
		min: ~max,
	}

	inline i64(Int64 x) = int64(x.value);

	/// Computes the arithmetic negation of a 64-bit signed integer
	static Int64 neg(Int64 x) { return { value: inline(i64(x), i64.neg) }; }

	/// Add two values
	static Int64 add(Int64 x, Int64 y) { return { value: inline(i64(x), i64(y), i64.add) }; }

	/// Subtract two values
	static Int64 sub(Int64 x, Int64 y) { return { value: inline(i64(x), i64(y), i64.sub) }; }

	/// Multiply two values
	static Int64 mul(Int64 x, Int64 y) { return { value: inline(i64(x), i64(y), i64.mul) }; }

	/// Divide x by y, returning quotient
	static Int64 div(Int64 x, Int64 y) { return { value: inline(i64(x), i64(y), i64.div) }; }

	/// Divide x by y, returning remainder
	static Int64 rem(Int64 x, Int64 y) { return { value: inline(i64(x), i64(y), i64.rem) }; }

	/// Computes the arithmetic negation of a 64-bit signed integer
	static Int64 neg(Int64 x, Int64 overflow&) {
		overflow.value = int64(i64(x) == min);
		return { value: inline(i64(x), i64.neg) };
	}

	/// Adds two 64-bit signed integers with carry out
	static Int64 add(Int64 x, Int64 y, Int64 overflow&) {
		int64 result = inline(i64(x), i64(y), i64.add);
		overflow.value = int64(((x.value ^ result) & (y.value ^ result)) < 0);
		return { value: result };
	}

	/// Subtracts two 64-bit signed integers with borrow out
	static Int64 sub(Int64 x, Int64 y, Int64 overflow&) {
		int64 result = inline(i64(x), i64(y), i64.sub);
		overflow.value = int64(((x.value ^ y.value) & (x.value ^ result)) < 0);
		return { value: result };
	}

	/// Multiplies two 64-bit signed integers with overflow out
	static Int64 mul(Int64 x, Int64 y, Int64 overflow&) {
		bool neg = false;
		if (x.value < 0) {
			neg = !neg;
			x.value = -x.value;
		}
		if (y.value < 0) {
			neg = !neg;
			y.value = -y.value;
		}

		Uint64 ux& = pointer(x);
		Uint64 uy& = pointer(y);
		Uint64 o& = pointer(overflow);
		Uint64 r = Uint64.mul(ux, uy, &o);
		if (neg) {
			r.value = -r.value;
			// Overflow from low to high
			o.value = ~o.value + int64(r.value == 0);
		}
		return { value: r.value };
	}

	/// Returns the sign of the value: `-1` if negative, `0` if zero, `1` if positive
	static int32 sign(Int64 x) {
		return int32(i64(x) > 0) - int32(i64(x) < 0);
	}

	/// Returns the absolute value
	static Int64 abs(Int64 x) { return i64(x) < 0 ? x.neg() : x; }

	/// Returns the smaller of two values
	static Int64 min(Int64 a, Int64 b) { return i64(a) < i64(b) ? a : b; }

	/// Returns the greater of two values
	static Int64 max(Int64 a, Int64 b) { return i64(a) > i64(b) ? a : b; }

	/// Returns the `value` clamped between the provided `lo` and `hi`
	static Int64 clamp(Int64 value, Int64 lo, Int64 hi) { return min(max(value, lo), hi); }

	/// Compare: returns 0 if equal, positive if x > y, negative if x < y
	static int32 compare(Int64 x, Int64 y) {
		return int32(i64(x) > i64(y)) - int32(i64(x) < i64(y));
	}

	/// todo: deprecated method, use the called one
	inline sign(int64 x) = sign(Int64(inline(x)));

	/// todo: deprecated method, use the called one
	inline abs(int64 x) = int64(inline(abs(Int64(inline(x)))));

	/// Extracts and sign-extends a bit field from a value
	static int64 signExtend(int64 value, int32 offs, int32 size) {
		return value << (bits - (offs + size)) >> (bits - size);
	}
}

/// Construct a Uint64 from a 64-bit unsigned value
Uint64 Uint64(uint64 value) { return { value: value }; }

/// Convert a Uint64 value to a uint64
uint64 uint64(Uint64 value) { return value.value; }

/// Construct an Int64 from a 64-bit signed value
Int64 Int64(int64 value) { return { value: value }; }

/// Convert an Int64 value to an int64
int64 int64(Int64 value) { return value.value; }
