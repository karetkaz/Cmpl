/// 16-bit unsigned integer
struct Uint16: 2 {
	uint16 value;

	enum {
		bits: 16,
		min: 0x0000,
		max: 0xffff,
	}

	inline u32(Uint16 x) = uint32(x.value);
	inline i32(Uint16 x) = int32(int16(x.value));

	/// Test if the value is zero or not, also the signum of the input (`0` if zero, `1` if positive)
	static int32 test(Uint16 x) { return int32(u32(x) > 0); }

	/// Negates a 16-bit unsigned value
	static Uint16 neg(Uint16 x) { return { value: inline(u32(x), i32.neg) }; }

	/// Adds two 16-bit unsigned integers
	static Uint16 add(Uint16 x, Uint16 y) { return { value: inline(u32(x), u32(y), i32.add) }; }

	/// Subtracts two 16-bit unsigned integers
	static Uint16 sub(Uint16 x, Uint16 y) { return { value: inline(u32(x), u32(y), i32.sub) }; }

	/// Multiplies two 16-bit unsigned integers
	static Uint16 mul(Uint16 x, Uint16 y) { return { value: inline(u32(x), u32(y), u32.mul) }; }

	/// Divides two 16-bit unsigned integers
	static Uint16 div(Uint16 x, Uint16 y) { return { value: inline(u32(x), u32(y), u32.div) }; }

	/// Divide x by y, returning remainder
	static Uint16 rem(Uint16 x, Uint16 y) { return { value: inline(u32(x), u32(y), u32.rem) }; }

	/// Negates a 16-bit unsigned value
	static Uint16 neg(Uint16 x, Uint16 overflow&) {
		overflow.value = 1; // always overflows
		return { value: inline(u32(x), i32.neg) };
	}

	/// Adds two 16-bit unsigned integers with carry out
	static Uint16 add(Uint16 x, Uint16 y, Uint16 overflow&) {
		uint32 result = inline(u32(x), u32(y), i32.add);
		overflow.value = result >> bits;
		return { value: result };
	}

	/// Adds two 16-bit unsigned integers with carry in and out
	static Uint16 add(Uint16 x, Uint16 y, Uint16 c, Uint16 overflow&) {
		uint32 result = inline(u32(x), u32(y), i32.add, u32(c), i32.add);
		overflow.value = result >> bits;
		return { value: result };
	}

	/// Subtracts two 16-bit unsigned integers with borrow out
	static Uint16 sub(Uint16 x, Uint16 y, Uint16 overflow&) {
		uint32 result = inline(u32(x), u32(y), i32.sub);
		overflow.value = -(result >> bits);
		return { value: result };
	}

	/// Subtracts two 16-bit unsigned integers with borrow in and out
	static Uint16 sub(Uint16 x, Uint16 y, Uint16 c, Uint16 overflow&) {
		uint32 result = inline(u32(x), u32(y), i32.sub, u32(c), i32.sub);
		overflow.value = -(result >> bits);
		return { value: result };
	}

	/// Multiplies two 16-bit unsigned integers with overflow out
	static Uint16 mul(Uint16 x, Uint16 y, Uint16 overflow&) {
		uint32 result = inline(u32(x), u32(y), u32.mul);
		overflow.value = result >> bits;
		return { value: result };
	}

	/// Computes the bitwise NOT of a 16-bit unsigned value
	static Uint16 cmt(Uint16 x) { return { value: inline(u32(x), u32.cmt) }; }

	/// Computes the bitwise OR of two 16-bit unsigned integers
	static Uint16 or(Uint16 x, Uint16 y) { return { value: inline(u32(x), u32(y), u32.or) }; }

	/// Computes the bitwise XOR of two 16-bit unsigned integers
	static Uint16 xor(Uint16 x, Uint16 y) { return { value: inline(u32(x), u32(y), u32.xor) }; }

	/// Computes the bitwise AND of two 16-bit unsigned integers
	static Uint16 and(Uint16 x, Uint16 y) { return { value: inline(u32(x), u32(y), u32.and) }; }

	/// Performs a logical left shift of x by n bits for a 16-bit unsigned integer
	static Uint16 shl(Uint16 x, uint32 n) { return { value: inline(u32(x), uint32(n % bits), u32.shl) }; }

	/// Performs a logical right shift of x by n bits for a 16-bit unsigned integer
	static Uint16 shr(Uint16 x, uint32 n) { return { value: inline(u32(x), uint32(n % bits), u32.shr) }; }

	/// Performs an arithmetic right shift of x by n bits for a 16-bit unsigned integer
	static Uint16 sar(Uint16 x, uint32 n) { return { value: inline(i32(x), uint32(n % bits), u32.sar) }; }

	/// Returns the value of x rotated left by (n mod size) bits
	static Uint16 rotateLeft(Uint16 x, uint32 n) {
		return x.shl(n & (bits - 1)).or(x.shr(bits - n & (bits - 1)));
	}

	/// Returns the value of x rotated right by (n mod size) bits
	static Uint16 rotateRight(Uint16 x, uint32 n) {
		return x.shr(n & (bits - 1)).or(x.shl(bits - n & (bits - 1)));
	}

	static Uint16 lowestBit(Uint16 x) { return x.and(neg(x)); }

	/// Returns the minimum number of bits required to represent the value of `x`
	static int32 length(Uint16 x) {
		static if (System.Platform.preferNativeCalls && struct(uint32.len) != null) {
			// use the native method if available
			return uint32.len(u32(x));
		}

		uint32 bits = u32(x);	// speed up by avoiding load and store indirect memory
		int32 result = 0;

		if ((bits >> 8) != 0) {
			result += 8;
			bits >>= 8;
		}
		if ((bits >> 4) != 0) {
			result += 4;
			bits >>= 4;
		}
		if ((bits >> 2) != 0) {
			result += 2;
			bits >>= 2;
		}
		if ((bits >> 1) != 0) {
			result += 1;
			bits >>= 1;
		}
		return result + bits;
	}

	/// Returns the number of leading zero bits in x
	static int32 leadingZeros(Uint16 x) { return bits - length(x); }

	/// Returns the number of trailing zero bits in x
	static int32 trailingZeros(Uint16 x) {
		if (x.value == 0) {
			return bits;
		}

		return x.lowestBit().length() - 1;
	}

	/// Finds the index of the most significant(highest) set bit.
	static int32 scanReverse(Uint16 x) { return x.length() - 1; }

	/// Finds the index of the least significant(lowest) set bit
	// or return x == 0 ? -1 : trailingZeros(x);
	static int32 scanForward(Uint16 x) { return x.lowestBit().length() - 1; }

	/// Returns the number of set bits ("population count") in x
	static int32 countOnes(Uint16 y) {
		static if (System.Platform.preferNativeCalls && struct(uint32.pop) != null) {
			// use the native method if available
			return uint32.pop(u32(y));
		}

		uint32 x = u32(y);
		x -= (x >> 1) & 0x5555;
		x = (x & 0x3333) + ((x >> 2) & 0x3333);
		x = (x + (x >> 4)) & 0x0f0f;
		return (x + (x >> 8)) & 0x1f;
	}

	/// Returns the value of x with its bits in reversed order
	static Uint16 reverseBits(Uint16 y) {
		uint32 x = u32(y);
		x = ((x >> 1) & 0x5555) | ((x & 0x5555) << 1);
		x = ((x >> 2) & 0x3333) | ((x & 0x3333) << 2);
		x = ((x >> 4) & 0x0f0f) | ((x & 0x0f0f) << 4);
		return { value: (x >> 8) | (x << 8) };
	}

	/// Reverses the byte order of a 16-bit unsigned integer
	static Uint16 reverseBytes(Uint16 y) {
		uint32 x = u32(y);
		return { value: (x & 0x00ff) << 8 | (x & 0xff00) >> 8 };
	}

	/// Returns the absolute value (identity for unsigned)
	static Uint16 abs(Uint16 x) { return x; }

	/// Returns the smaller of two values
	static Uint16 min(Uint16 a, Uint16 b) { return u32(a) < u32(b) ? a : b; }

	/// Returns the greater of two values
	static Uint16 max(Uint16 a, Uint16 b) { return u32(a) > u32(b) ? a : b; }

	/// Returns the `value` clamped between the provided `lo` and `hi`
	static Uint16 clamp(Uint16 value, Uint16 lo, Uint16 hi) { return min(max(value, lo), hi); }

	/// Compare: returns 0 if equal, positive if x > y, negative if x < y
	static int32 compare(Uint16 x, Uint16 y) {
		return u32(x) - u32(y);
	}
}

/// 16-bit signed integer
struct Int16: 2 {
	int16 value;

	enum {
		bits: Uint16.bits,
		min: -32768,
		max: 32767,
	}

	inline i32(Int16 x) = int32(x.value);

	/// Computes the arithmetic negation of a 16-bit signed integer
	static Int16 neg(Int16 x) { return { value: inline(i32(x), i32.neg) }; }

	/// Add two values
	static Int16 add(Int16 x, Int16 y) { return { value: inline(i32(x), i32(y), i32.add) }; }

	/// Subtract two values
	static Int16 sub(Int16 x, Int16 y) { return { value: inline(i32(x), i32(y), i32.sub) }; }

	/// Multiply two values
	static Int16 mul(Int16 x, Int16 y) { return { value: inline(i32(x), i32(y), i32.mul) }; }

	/// Divide x by y, returning quotient
	static Int16 div(Int16 x, Int16 y) { return { value: inline(i32(x), i32(y), i32.div) }; }

	/// Divide x by y, returning remainder
	static Int16 rem(Int16 x, Int16 y) { return { value: inline(i32(x), i32(y), i32.rem) }; }

	/// Computes the arithmetic negation of a 16-bit signed integer
	static Int16 neg(Int16 x, Int16 overflow&) {
		overflow.value = int32(i32(x) == min);
		return { value: inline(i32(x), i32.neg) };
	}

	/// Add two values with carry-out
	static Int16 add(Int16 x, Int16 y, Int16 overflow&) {
		int32 result = inline(i32(x), i32(y), i32.add);
		overflow.value = int32(result > max || result < min);
		return { value: result };
	}

	/// Subtract two values with borrow-out
	static Int16 sub(Int16 x, Int16 y, Int16 overflow&) {
		int32 result = inline(i32(x), i32(y), i32.sub);
		overflow.value = int32(result > max || result < min);
		return { value: result };
	}

	/// Multiply two values with overflow-out (overflow holds upper 16 bits of the 32-bit product)
	static Int16 mul(Int16 x, Int16 y, Int16 overflow&) {
		int32 result = inline(i32(x), i32(y), i32.mul);
		overflow.value = result >> bits;
		return { value: result };
	}

	/// Returns the sign of the value: `-1` if negative, `0` if zero, `1` if positive
	static int32 sign(Int16 x) {
		return int32(i32(x) > 0) - int32(i32(x) < 0);
	}

	/// Returns the absolute value
	static Int16 abs(Int16 x) { return i32(x) < 0 ? x.neg() : x; }

	/// Returns the smaller of two values
	static Int16 min(Int16 a, Int16 b) { return i32(a) < i32(b) ? a : b; }

	/// Returns the greater of two values
	static Int16 max(Int16 a, Int16 b) { return i32(a) > i32(b) ? a : b; }

	/// Returns the `value` clamped between the provided `lo` and `hi`
	static Int16 clamp(Int16 value, Int16 lo, Int16 hi) { return min(max(value, lo), hi); }

	/// Compare: returns 0 if equal, positive if x > y, negative if x < y
	static int32 compare(Int16 x, Int16 y) {
		return i32(x) - i32(y);
	}
}

/// Construct a Uint16 from a 16-bit unsigned value
Uint16 Uint16(uint16 value) { return { value: value }; }

/// Convert a Uint16 value to a uint32
uint32 uint32(Uint16 value) { return value.value; }

/// Construct an Int16 from a 16-bit signed value
Int16 Int16(int16 value) { return { value: value }; }

/// Convert an Int16 value to an int32
int32 int32(Int16 value) { return value.value; }
