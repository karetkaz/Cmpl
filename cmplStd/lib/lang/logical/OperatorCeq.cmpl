inline ==(int32 a, int32 b) = bool(inline(int32(a), int32(b), i32.ceq));
inline ==(int64 a, int64 b) = bool(inline(int64(a), int64(b), i64.ceq));
inline ==(uint32 a, uint32 b) = bool(inline(uint32(a), uint32(b), i32.ceq));
