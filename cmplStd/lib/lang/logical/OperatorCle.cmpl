inline <=(int32 a, int32 b) = bool(inline(int32(a), int32(b), i32.cgt, not));
inline <=(int64 a, int64 b) = bool(inline(int64(a), int64(b), i64.cgt, not));
inline <=(uint32 a, uint32 b) = bool(inline(uint32(a), uint32(b), u32.cgt, not));
inline <=(uint64 a, uint64 b) = bool(inline(uint64(a), uint64(b), u64.cgt, not));
inline <=(float32 a, float32 b) = bool(inline(
	int32(0), // result
	float32(a), float32(b),
	dup2, f32.clt,
	set1_3,	// write result
	f32.ceq,
	u32.or	// or result
));
inline <=(float64 a, float64 b) = bool(inline(
	int32(0), // result
	float64(a), float64(b),
	dup4, f64.clt,
	set1_5,	// write result
	f64.ceq,
	u32.or	// or result
));

