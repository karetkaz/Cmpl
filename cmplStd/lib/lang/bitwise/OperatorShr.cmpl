inline >>(int32 a, uint32 b) = int32(inline(int32(a), uint32(b), u32.sar));
inline >>(int64 a, uint32 b) = int64(inline(int64(a), uint32(b), u64.sar));
inline >>(uint32 a, uint32 b) = uint32(inline(uint32(a), uint32(b), u32.shr));
inline >>(uint64 a, uint32 b) = uint64(inline(uint64(a), uint32(b), u64.shr));

inline >>(int8 a, int8 b) = +a >> uint32(b);
inline >>(int8 a, int16 b) = +a >> uint32(b);
