inline ^(int32 a, int32 b) = int32(inline(int32(a), int32(b), u32.xor));
inline ^(int64 a, int64 b) = int64(inline(int64(a), int64(b), u64.xor));
inline ^(uint32 a, uint32 b) = uint32(inline(uint32(a), uint32(b), u32.xor));
inline ^(uint64 a, uint64 b) = uint64(inline(uint64(a), uint64(b), u64.xor));

inline ^(int8 a, int8 b) = +a ^ +b;
inline ^(int8 a, int16 b) = +a ^ +b;
inline ^(int8 a, int32 b) = +a ^ +b;
inline ^(int8 a, int64 b) = int64(a) ^ b;
inline ^(int8 a, uint8 b) = +a ^ +b;
inline ^(int8 a, uint16 b) = +a ^ +b;
inline ^(int8 a, uint32 b) = uint32(a) ^ b;
inline ^(int8 a, uint64 b) = uint64(a) ^ b;

inline ^(int16 a, int8 b) = +a ^ +b;
inline ^(int16 a, int16 b) = +a ^ +b;
inline ^(int16 a, int32 b) = +a ^ +b;
inline ^(int16 a, int64 b) = int64(a) ^ b;
inline ^(int16 a, uint8 b) = +a ^ +b;
inline ^(int16 a, uint16 b) = +a ^ +b;
inline ^(int16 a, uint32 b) = uint32(a) ^ b;
inline ^(int16 a, uint64 b) = uint64(a) ^ b;

inline ^(int32 a, int8 b) = +a ^ +b;
inline ^(int32 a, int16 b) = +a ^ +b;
//inline ^(int32 a, int32 b) = a ^ b;
inline ^(int32 a, int64 b) = int64(a) ^ b;
inline ^(int32 a, uint8 b) = +a ^ +b;
inline ^(int32 a, uint16 b) = +a ^ +b;
inline ^(int32 a, uint32 b) = uint32(a) ^ b;
inline ^(int32 a, uint64 b) = uint64(a) ^ b;

inline ^(int64 a, int8 b) = a ^ int64(b);
inline ^(int64 a, int16 b) = a ^ int64(b);
inline ^(int64 a, int32 b) = a ^ int64(b);
//inline ^(int64 a, int64 b) = a ^ b;
inline ^(int64 a, uint8 b) = a ^ int64(b);
inline ^(int64 a, uint16 b) = a ^ int64(b);
inline ^(int64 a, uint32 b) = a ^ int64(b);
inline ^(int64 a, uint64 b) = uint64(a) ^ b;

inline ^(uint8 a, int8 b) = +a ^ +b;
inline ^(uint8 a, int16 b) = +a ^ +b;
inline ^(uint8 a, int32 b) = +a ^ +b;
inline ^(uint8 a, int64 b) = int64(a) ^ b;
inline ^(uint8 a, uint8 b) = +a ^ +b;
inline ^(uint8 a, uint16 b) = +a ^ +b;
inline ^(uint8 a, uint32 b) = uint32(a) ^ b;
inline ^(uint8 a, uint64 b) = uint64(a) ^ b;

inline ^(uint16 a, int8 b) = +a ^ +b;
inline ^(uint16 a, int16 b) = +a ^ +b;
inline ^(uint16 a, int32 b) = +a ^ +b;
inline ^(uint16 a, int64 b) = int64(a) ^ b;
inline ^(uint16 a, uint8 b) = +a ^ +b;
inline ^(uint16 a, uint16 b) = +a ^ +b;
inline ^(uint16 a, uint32 b) = uint32(a) ^ b;
inline ^(uint16 a, uint64 b) = uint64(a) ^ b;

inline ^(uint32 a, int8 b) = a ^ uint32(b);
inline ^(uint32 a, int16 b) = a ^ uint32(b);
inline ^(uint32 a, int32 b) = a ^ uint32(b);
inline ^(uint32 a, int64 b) = int64(a) ^ +b;
inline ^(uint32 a, uint8 b) = a ^ uint32(b);
inline ^(uint32 a, uint16 b) = a ^ uint32(b);
//inline ^(uint32 a, uint32 b) = a ^ b;
inline ^(uint32 a, uint64 b) = uint64(a) ^ b;

inline ^(uint64 a, int8 b) = a ^ uint64(b);
inline ^(uint64 a, int16 b) = a ^ uint64(b);
inline ^(uint64 a, int32 b) = a ^ uint64(b);
inline ^(uint64 a, int64 b) = a ^ uint64(b);
inline ^(uint64 a, uint8 b) = a ^ uint64(b);
inline ^(uint64 a, uint16 b) = a ^ uint64(b);
inline ^(uint64 a, uint32 b) = a ^ uint64(b);
//inline ^(uint64 a, uint64 b) = a ^ b;
